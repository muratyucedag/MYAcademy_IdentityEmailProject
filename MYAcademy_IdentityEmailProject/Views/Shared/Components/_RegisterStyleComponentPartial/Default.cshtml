                box-shadow: none;
                min-height: 100vh;
                min-height: 100dvh;
            }

            .auth-brand {
                padding: 22px 20px 20px;
            }

                .auth-brand > p {
                    font-size: 13.5px;
                }

            .brand-kicker {
                display: none;
            }

            .auth-brand h2 {
                font-size: 21px;
                margin-top: 16px;
            }

            .auth-form-wrap {
                padding: 24px 20px 30px;
                justify-content: flex-start;
            }

            .form-head h1 {
                font-size: 24px;
            }

            .form-head p {
                font-size: 13.5px;
            }

            .form-grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 14px;
            }

            .a-input {
                font-size: 16px;
            }
            /* iOS'ta otomatik yakınlaştırmayı önler */
            .rules {
                grid-template-columns: minmax(0, 1fr);
            }

            .k-modal {
                padding: 0;
                place-items: end center;
            }

            .k-dialog {
                max-height: 92vh;
                max-height: 92dvh;
                border-radius: 22px 22px 0 0;
            }

            .k-modal .k-dialog {
                transform: translateY(40px);
            }

            .k-modal.open .k-dialog {
                transform: none;
            }

            .k-head {
                padding: 18px 18px 14px;
            }

                .k-head .ic {
                    display: none;
                }

            .k-body {
                padding: 18px 18px 6px;
                font-size: 13.5px;
            }

            .k-foot {
                flex-wrap: wrap;
                padding: 14px 18px calc(14px + env(safe-area-inset-bottom));
            }

                .k-foot .read-hint {
                    flex-basis: 100%;
                    justify-content: center;
                }

                .k-foot .btn-ghost, .k-foot .btn-primary-x {
                    flex: 1 1 100%;
                    white-space: nowrap;
                }

                .k-foot .btn-primary-x {
                    order: 1;
                }

                .k-foot .btn-ghost {
                    order: 2;
                }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>