        function showToast(text, icon = 'bi-check2-circle', action) {
          const stack = $('#toastStack');
          const el = document.createElement('div');
          el.className = 'm-toast';
          el.innerHTML = `<i class="bi ${icon} lead-ic"></i><span>${text}</span>`;
          if (action) {
            const b = document.createElement('button');
            b.textContent = action.label;
            b.onclick = () => { action.onClick(); close(); };
            el.appendChild(b);
          }
          stack.appendChild(el);
          const close = () => { el.classList.add('out'); setTimeout(() => el.remove(), 250); };
          setTimeout(close, action ? 5000 : 2800);
        }

        /* Sidebar rozetlerini günceller (Sidebar'ı yeniden oluşturmaz) */
