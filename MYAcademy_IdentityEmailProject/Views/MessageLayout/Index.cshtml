                  </div>
                </div>
              </div>

            </section>`;
        }

        function initComposeView() {
          // İlk açılışta localStorage'daki taslağı geri yükle
          if (!composeState.restored) {
            composeState.restored = true;
            const d = draftStorage.get();
            if (d && isComposeEmpty()) {
              Object.assign(composeState, {
                to: d.to || [], cc: d.cc || [], bcc: d.bcc || [],
                showCc: !!d.showCc || !!(d.cc || []).length, showBcc: !!d.showBcc || !!(d.bcc || []).length,
                subject: d.subject || '', body: d.body || '', savedAt: d.savedAt || null
              });
              setTimeout(() => showToast('Kaydedilmiş taslağınız geri yüklendi.', 'bi-file-earmark-check'), 350);
            }
          }

          // Dashboard > En Sık İletişim Kurulanlar üzerinden gelen alıcı
          let pendingAdded = null;
          if (composeState.pendingTo) {
            const r = composeState.pendingTo;
            composeState.pendingTo = null;
            if (!composeState.to.some(x => x.email === r.email)) { composeState.to.push(r); pendingAdded = r; }
          }

          const editor = $('#cmpEditor'), subject = $('#cmpSubject');
          try { document.execCommand('defaultParagraphSeparator', false, 'p'); document.execCommand('styleWithCSS', false, true); } catch (e) { /* eski tarayıcı */ }

          subject.value = composeState.subject;
          editor.innerHTML = composeState.body;

          ['to', 'cc', 'bcc'].forEach(bindRecipientField);
          setOptionalRow('cc', composeState.showCc, false);
          setOptionalRow('bcc', composeState.showBcc, false);
          $$('[data-show]').forEach(btn => btn.addEventListener('click', () => setOptionalRow(btn.dataset.show, true)));
          $$('[data-hide]').forEach(btn => btn.addEventListener('click', () => setOptionalRow(btn.dataset.hide, false)));

          subject.addEventListener('input', () => { composeState.subject = subject.value; clearFieldError($('#rowSubject')); markDirty(); });
          subject.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); editor.focus(); } });

          editor.addEventListener('input', () => {
            if (['<br>', '<p><br></p>', '<div><br></div>'].includes(editor.innerHTML.trim())) editor.innerHTML = '';
            composeState.body = editor.innerHTML;
            updateCounter(); clearFieldError($('#rowBody')); markDirty();
          });
          // Dışarıdan yapıştırılan biçimleri temizle (düz metin olarak ekle)
          editor.addEventListener('paste', e => {
            const text = (e.clipboardData || window.clipboardData).getData('text/plain');
            e.preventDefault();
            document.execCommand('insertText', false, text);
          });

          bindToolbar();
          bindAttachments();
          renderFiles();
          updateCounter();
          updateStatus(composeState.dirty ? 'dirty' : composeState.savedAt ? 'saved' : 'empty');

          $('#cmpForm').addEventListener('submit', e => { e.preventDefault(); sendMessage(); });
          $('#cmpDraft').addEventListener('click', () => saveDraft(false));
          $('#cmpClear').addEventListener('click', openClearDialog);
          $('#cmpDialog').addEventListener('click', e => {
            const act = e.target.closest('[data-dialog]')?.dataset.dialog;
            if (act === 'ok') confirmClear();
            else if (act === 'cancel' || e.target.id === 'cmpDialog') closeClearDialog();
          });

          $('#compose').addEventListener('keydown', e => {
            const mod = e.ctrlKey || e.metaKey;
            if (mod && e.key === 'Enter') { e.preventDefault(); sendMessage(); }
            if (mod && e.key.toLowerCase() === 's') { e.preventDefault(); saveDraft(false); }
            if (e.key === 'Escape') { closePops(); closeClearDialog(); }
          });

          if (window.innerWidth >= 768) (composeState.to.length ? (composeState.subject ? editor : subject) : $('#rf-to')).focus();
          if (pendingAdded) { markDirty(); showToast(`${pendingAdded.name} alıcı olarak eklendi.`, 'bi-person-plus'); }
        }

        /* --- Alıcı alanları (Kime / CC / BCC) --- */
        function bindRecipientField(key) {
          const row = $(`[data-rf="${key}"]`), box = $('.rf-box', row), input = $('.rf-input', row);
          const sug = $('.rf-suggest', row), err = $('.cmp-err', row);
          let results = [], active = -1;

          function renderChips() {
            $$('.rf-chip', box).forEach(c => c.remove());
            composeState[key].forEach((r, i) => {
              const chip = document.createElement('span');
              chip.className = 'rf-chip' + (r.valid ? '' : ' invalid');
              chip.title = r.valid ? r.email : 'Geçersiz adres — düzenlemek için tıklayın';
              chip.innerHTML = (r.valid
                  ? `<span class="avatar xs ${r.color || 'av-lav'}">${initials(r.name || r.email)}</span>`
                  : `<i class="bi bi-exclamation-triangle-fill"></i>`)
                + `<span class="t">${escapeHtml(r.name || r.email)}</span>`
                + `<button type="button" class="x" aria-label="${escapeHtml(r.email)} adresini kaldır"><i class="bi bi-x"></i></button>`;
              chip.addEventListener('click', e => {
                e.stopPropagation();
                if (e.target.closest('.x')) { remove(i); return; }
                if (!r.valid) { composeState[key].splice(i, 1); input.value = r.email; renderChips(); markDirty(); input.focus(); }
              });
              box.insertBefore(chip, input);
            });
            if (key === 'to') input.placeholder = composeState.to.length ? '' : 'E-posta adresi veya isim yazın';
            updateError();
          }

          function updateError() {
            const bad = composeState[key].filter(r => !r.valid);
            if (bad.length) { row.classList.add('has-error'); err.textContent = `Geçersiz e-posta adresi: ${bad.map(b => b.email).join(', ')}`; }
            else { row.classList.remove('has-error'); err.textContent = ''; }
          }

          function remove(i) { composeState[key].splice(i, 1); renderChips(); markDirty(); input.focus(); }

          function add(raw) {
            const parts = String(raw).split(/[,;\s]+/).map(s => s.trim().replace(/^<|>$/g, '')).filter(Boolean);
            let changed = false;
            parts.forEach(p => {
              const email = p.toLowerCase();
              if (composeState[key].some(r => r.email === email)) { showToast(`${email} zaten ekli.`, 'bi-info-circle'); return; }
              const c = contacts.find(x => x.email === email);
              composeState[key].push({ email, name: c ? c.name : '', color: c ? c.color : 'av-lav', valid: EMAIL_RE.test(email) });
              changed = true;
            });
            if (changed) { renderChips(); markDirty(); }
          }

          function commit() { if (input.value.trim()) { add(input.value); input.value = ''; } closeSug(); }

          function openSug() {
            const q = norm(input.value.trim());
            if (!q) { closeSug(); return; }
            const taken = new Set(['to', 'cc', 'bcc'].flatMap(k => composeState[k].map(r => r.email)));
            results = contacts.filter(c => !taken.has(c.email) && (norm(c.name).includes(q) || c.email.includes(q))).slice(0, 5);
            if (!results.length) { closeSug(); return; }
            active = 0;
            sug.innerHTML = `<li class="rs-head">Önerilen kişiler</li>` + results.map((c, i) => `
              <li class="rs-item ${i === active ? 'active' : ''}" data-i="${i}" role="option">
                <span class="avatar sm ${c.color}">${initials(c.name)}</span>
                <span class="rs-text"><b>${highlight(c.name, q)}</b><span>${highlight(c.email, q)}</span></span>
              </li>`).join('');
            sug.classList.add('show');
          }
          function closeSug() { sug.classList.remove('show'); sug.innerHTML = ''; results = []; active = -1; }
          function setActive(i) { active = (i + results.length) % results.length; $$('.rs-item', sug).forEach((li, j) => li.classList.toggle('active', j === active)); }
          function pick(i) { const c = results[i]; if (!c) return; input.value = ''; closeSug(); add(c.email); input.focus(); }

          input.addEventListener('input', () => {
            if (/[,;]/.test(input.value)) {
              const v = input.value, last = v.split(/[,;]/).pop();
              add(v.slice(0, v.length - last.length));
              input.value = last.trimStart();
            }
            openSug();
          });
          input.addEventListener('keydown', e => {
            if (results.length && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) { e.preventDefault(); setActive(active + (e.key === 'ArrowDown' ? 1 : -1)); return; }
            if (e.key === 'Enter' || (e.key === 'Tab' && input.value.trim())) {
              e.preventDefault();
              if (e.ctrlKey || e.metaKey) { commit(); return; }       // Ctrl+Enter → gönderim (üst seviyede yakalanır)
              if (results.length && active > -1) pick(active); else commit();
              return;
            }
            if (e.key === 'Backspace' && !input.value && composeState[key].length) remove(composeState[key].length - 1);
            if (e.key === 'Escape') closeSug();
          });
          input.addEventListener('paste', e => {
            const t = (e.clipboardData || window.clipboardData).getData('text');
            if (/[,;\s]/.test(t.trim())) { e.preventDefault(); add(t); }
          });
          input.addEventListener('blur', () => setTimeout(() => { if (document.activeElement !== input) commit(); }, 120));
          sug.addEventListener('mousedown', e => { const li = e.target.closest('.rs-item'); if (li) { e.preventDefault(); pick(+li.dataset.i); } });
          box.addEventListener('click', () => input.focus());

          rfApi[key] = { commit, render: renderChips, clear() { composeState[key] = []; input.value = ''; renderChips(); } };
          renderChips();
        }

        function setOptionalRow(key, show, focus = true) {
          const row = $(`[data-rf="${key}"]`);
          if (!row) return;
          row.hidden = !show;
          composeState[key === 'cc' ? 'showCc' : 'showBcc'] = show;
          const toggle = $(`[data-show="${key}"]`);
          if (toggle) toggle.classList.toggle('used', show);
          if (!show && composeState[key].length) { rfApi[key].clear(); markDirty(); }
          if (show && focus) $(`#rf-${key}`).focus();
        }

        /* --- Rich text editör --- */
        const STATE_CMDS = ['bold', 'italic', 'underline', 'strikeThrough', 'insertUnorderedList', 'insertOrderedList', 'justifyLeft', 'justifyCenter', 'justifyRight'];
        const BLOCK_LABELS = { p: 'Paragraf', div: 'Paragraf', h1: 'Başlık 1', h2: 'Başlık 2', h3: 'Başlık 3', blockquote: 'Alıntı' };

        function bindToolbar() {
          const tb = $('#cmpToolbar');
          // Butona basınca editördeki seçim kaybolmasın
          tb.addEventListener('mousedown', e => { if (e.target.closest('button') && !e.target.closest('.tb-link .r')) e.preventDefault(); });
          tb.addEventListener('click', e => {
            const btn = e.target.closest('button');
            if (!btn) return;
            if (btn.dataset.cmd) { closePops(); exec(btn.dataset.cmd); }
            else if (btn.dataset.pop) togglePop(btn.dataset.pop, btn);
            else if (btn.dataset.block) { exec('formatBlock', `<${btn.dataset.block}>`); closePops(); }
            else if (btn.dataset.color) { exec('foreColor', btn.dataset.color); $('#tbColorBar').style.background = btn.dataset.color; closePops(); }
            else if (btn.dataset.link === 'add') insertLink();
            else if (btn.dataset.link === 'remove') { exec('unlink'); closePops(); }
          });
          $('#tbLinkInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); insertLink(); } });
          updateToolbarState();
        }

        function saveSelection() {
          const ed = $('#cmpEditor'), sel = window.getSelection();
          if (ed && sel.rangeCount && ed.contains(sel.anchorNode)) savedRange = sel.getRangeAt(0).cloneRange();
        }
        function restoreSelection() {
          const ed = $('#cmpEditor');
          if (savedRange && ed && ed.contains(savedRange.startContainer)) {
            const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange);
          }
        }

        function exec(cmd, value = null) {
          const editor = $('#cmpEditor');
          if (!editor) return;
          editor.focus();
          restoreSelection();
          document.execCommand(cmd, false, value);
          if (cmd === 'removeFormat') { document.execCommand('unlink'); document.execCommand('formatBlock', false, '<p>'); }
          saveSelection();
          composeState.body = editor.innerHTML;
          updateCounter(); clearFieldError($('#rowBody')); markDirty(); updateToolbarState();
        }

        function insertLink() {
          const input = $('#tbLinkInput');
          const raw = input.value.trim();
          if (!raw) { input.focus(); return; }
          const url = /^(https?:|mailto:)/i.test(raw) ? raw : (EMAIL_RE.test(raw) ? 'mailto:' : 'https://') + raw;
          const editor = $('#cmpEditor');
          editor.focus(); restoreSelection();
          const sel = window.getSelection();
          if (!sel.rangeCount || sel.isCollapsed || !editor.contains(sel.anchorNode)) {
            document.execCommand('insertHTML', false, `<a href="${escapeHtml(url)}">${escapeHtml(raw)}</a>&nbsp;`);
          } else {
            document.execCommand('createLink', false, url);
          }
          input.value = '';
          closePops();
          saveSelection();
          composeState.body = editor.innerHTML;
          updateCounter(); clearFieldError($('#rowBody')); markDirty();
        }

        function updateToolbarState() {
          const tb = $('#cmpToolbar'), ed = $('#cmpEditor');
          if (!tb || !ed) return;
          const sel = window.getSelection();
          const inEditor = sel.rangeCount > 0 && ed.contains(sel.anchorNode);
          STATE_CMDS.forEach(c => {
            const btn = $(`[data-cmd="${c}"]`, tb);
            let on = false;
            if (inEditor) { try { on = document.queryCommandState(c); } catch (e) { on = false; } }
            if (btn) btn.classList.toggle('active', on);
          });
          let block = '';
          if (inEditor) { try { block = String(document.queryCommandValue('formatBlock') || '').toLowerCase().replace(/[<>]/g, ''); } catch (e) { block = ''; } }
          $('#tbBlockLabel').textContent = BLOCK_LABELS[block] || 'Paragraf';
        }

        function togglePop(name, btn) {
          const pop = $(`[data-pop-for="${name}"]`);
          const willOpen = !pop.classList.contains('show');
          closePops();
          if (!willOpen) return;
          pop.classList.add('show');
          btn.classList.add('open');
          // Ekran dışına taşmayı engelle
          pop.style.left = '0px';
          const r = pop.getBoundingClientRect();
          const over = r.right - (window.innerWidth - 12);
          if (over > 0) pop.style.left = `${-over}px`;
          if (name === 'link') setTimeout(() => $('#tbLinkInput').focus(), 30);
        }
        function closePops() {
          $$('.tb-pop.show').forEach(p => p.classList.remove('show'));
          $$('.tb-btn.open').forEach(b => b.classList.remove('open'));
        }

        function updateCounter() {
          const ed = $('#cmpEditor'), out = $('#cmpCounter');
          if (!ed || !out) return;
          const text = ed.innerText.replace(/\u00a0/g, ' ').trim();
          const words = text ? text.split(/\s+/).length : 0;
          out.textContent = `${words.toLocaleString('tr-TR')} kelime · ${text.length.toLocaleString('tr-TR')} karakter`;
        }

        /* --- Dosya ekleri (yalnızca tarayıcı tarafında) --- */
        const hasFiles = e => !!e.dataTransfer && [...e.dataTransfer.types].includes('Files');

        function bindAttachments() {
          const drop = $('#cmpDrop'), input = $('#cmpFile'), section = $('#compose');
          input.addEventListener('change', () => { addFiles(input.files); input.value = ''; });
          drop.addEventListener('click', e => { if (!e.target.closest('label')) input.click(); });

          let depth = 0;
          section.addEventListener('dragenter', e => { if (!hasFiles(e)) return; e.preventDefault(); depth++; drop.classList.add('drag'); });
          section.addEventListener('dragover', e => { if (!hasFiles(e)) return; e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
          section.addEventListener('dragleave', e => { if (!hasFiles(e)) return; depth = Math.max(0, depth - 1); if (!depth) drop.classList.remove('drag'); });
          section.addEventListener('drop', e => {
            if (!hasFiles(e)) return;
            e.preventDefault(); depth = 0; drop.classList.remove('drag');
            addFiles(e.dataTransfer.files);
          });

          $('#cmpFiles').addEventListener('click', e => {
            const btn = e.target.closest('[data-remove]');
            if (!btn) return;
            const i = composeState.files.findIndex(f => f.id === +btn.dataset.remove);
            if (i < 0) return;
            const [f] = composeState.files.splice(i, 1);
            if (f.url) URL.revokeObjectURL(f.url);
            renderFiles(); markDirty();
            showToast(`${f.name} kaldırıldı.`, 'bi-x-circle');
          });
        }

        function fileMeta(ext) {
          if (ext === 'pdf') return { ic: 'bi-file-earmark-pdf-fill', c: 'av-rose', t: 'PDF' };
          if (['doc', 'docx', 'odt', 'rtf'].includes(ext)) return { ic: 'bi-file-earmark-word-fill', c: 'av-blue', t: 'Word' };
          if (['xls', 'xlsx', 'csv', 'ods'].includes(ext)) return { ic: 'bi-file-earmark-excel-fill', c: 'av-mint', t: 'Excel' };
          if (['ppt', 'pptx', 'odp', 'key'].includes(ext)) return { ic: 'bi-file-earmark-ppt-fill', c: 'av-peach', t: 'Sunum' };
          if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'bmp', 'heic'].includes(ext)) return { ic: 'bi-file-earmark-image-fill', c: 'av-lav', t: 'Görsel' };
          if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) return { ic: 'bi-file-earmark-zip-fill', c: 'av-sun', t: 'Arşiv' };
          if (['txt', 'md'].includes(ext)) return { ic: 'bi-file-earmark-text-fill', c: 'av-blue', t: 'Metin' };
          return { ic: 'bi-file-earmark-fill', c: 'av-lav', t: ext ? ext.toUpperCase() : 'Dosya' };
        }

        function addFiles(list) {
          let total = composeState.files.reduce((s, f) => s + f.size, 0), added = 0;
          const skipped = [];
          [...list].forEach(file => {
            if (composeState.files.some(f => f.name === file.name && f.size === file.size)) { skipped.push(`${file.name} zaten ekli`); return; }
            if (total + file.size > MAX_TOTAL) { skipped.push(`${file.name} eklenemedi: 25 MB sınırı aşılıyor`); return; }
            const ext = file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';
            const isImg = file.type.startsWith('image/');
            composeState.files.push({ id: ++fileSeq, file, name: file.name, size: file.size, ext, url: isImg ? URL.createObjectURL(file) : null, isNew: true });
            total += file.size; added++;
          });
          renderFiles();
          if (added) { markDirty(); showToast(`${added} dosya eklendi.`, 'bi-paperclip'); }
          if (skipped.length) showToast(skipped[0] + (skipped.length > 1 ? ` (+${skipped.length - 1})` : ''), 'bi-exclamation-circle');
        }

        function renderFiles() {
          const head = $('#cmpFilesHead'), list = $('#cmpFiles');
          if (!head || !list) return;
          const files = composeState.files;
          const total = files.reduce((s, f) => s + f.size, 0);
          head.innerHTML = files.length ? `
            <span><i class="bi bi-paperclip"></i> Ekler (${files.length})</span>
            <span class="fsz">${formatSize(total)} / 25 MB</span>
            <span class="fbar"><span style="width:${Math.min(100, total / MAX_TOTAL * 100).toFixed(1)}%"></span></span>` : '';
          list.innerHTML = files.map(f => {
            const m = fileMeta(f.ext);
            return `
              <div class="cf-item ${f.isNew ? 'new' : ''}">
                <div class="cf-thumb ${m.c}">${f.url ? `<img src="${f.url}" alt="">` : `<i class="bi ${m.ic}"></i>`}</div>
                <div class="cf-info">
                  <div class="cf-name" title="${escapeHtml(f.name)}">${escapeHtml(f.name)}</div>
                  <div class="cf-meta">${m.t} · ${formatSize(f.size)}</div>
                </div>
                <button type="button" class="tool-btn cf-remove" data-remove="${f.id}" title="Kaldır" aria-label="${escapeHtml(f.name)} dosyasını kaldır"><i class="bi bi-x-lg"></i></button>
              </div>`;
          }).join('');
          files.forEach(f => { f.isNew = false; });
        }

        /* --- Taslak durumu --- */
        function updateStatus(state) {
          const el = $('#cmpStatus');
          if (!el) return;
          const text = {
            empty: 'Yeni taslak',
            dirty: 'Kaydedilmemiş değişiklikler',
            saving: 'Kaydediliyor…',
            saved: composeState.savedAt ? `Taslak kaydedildi · ${fmtClock(composeState.savedAt)}` : 'Taslak kaydedildi'
          }[state];
          el.dataset.state = state;
          $('.stext', el).textContent = text;
        }

        function markDirty() {
          if (composeState.sending) return;
          composeState.dirty = true;
          composeState.version++;
          updateStatus('dirty');
          clearTimeout(autosaveTimer);
          if (prefs.autoSaveDraft) autosaveTimer = setTimeout(() => saveDraft(true), 3000);   // otomatik kayıt (Profilim > Tercihler)
        }

        function saveDraft(silent) {
          clearTimeout(autosaveTimer);
          if (composeState.sending) return;
          if (isComposeEmpty()) {
            if (!silent) showToast('Kaydedilecek bir içerik yok.', 'bi-info-circle');
            draftStorage.clear();
            Object.assign(composeState, { dirty: false, savedAt: null });
            updateStatus('empty');
            return;
          }
          const v = composeState.version;
          updateStatus('saving');
          setTimeout(() => {
            const s = composeState;
            s.savedAt = new Date().toISOString();
            const ok = draftStorage.set({ to: s.to, cc: s.cc, bcc: s.bcc, showCc: s.showCc, showBcc: s.showBcc, subject: s.subject, body: s.body, savedAt: s.savedAt });
            if (s.version === v) { s.dirty = false; updateStatus('saved'); } else updateStatus('dirty');
            if (!silent) {
              const note = s.files.length ? ' Ekler taslakta saklanmaz.' : '';
              showToast((ok ? 'Taslak kaydedildi.' : 'Taslak bu oturum için kaydedildi.') + note, 'bi-floppy');
            }
          }, 450);
        }

        /* --- Doğrulama & gönderim simülasyonu --- */
        function setFieldError(row, msg) {
          row.classList.add('has-error');
          $('.cmp-err', row).textContent = msg;
          row.classList.remove('shake'); void row.offsetWidth; row.classList.add('shake');
        }
        function clearFieldError(row) {
          if (!row || !row.classList.contains('has-error')) return;
          row.classList.remove('has-error');
          $('.cmp-err', row).textContent = '';
        }

        function validateCompose() {
          ['to', 'cc', 'bcc'].forEach(k => rfApi[k] && rfApi[k].commit());
          let firstFocus = null;
          const fail = (row, msg, el) => { setFieldError(row, msg); if (!firstFocus) firstFocus = el; };

          if (!composeState.to.length) fail($('[data-rf="to"]'), 'En az bir alıcı ekleyin.', $('#rf-to'));
          ['to', 'cc', 'bcc'].forEach(k => {
            const bad = composeState[k].filter(r => !r.valid);
            if (bad.length) fail($(`[data-rf="${k}"]`), `Geçersiz e-posta adresi: ${bad.map(b => b.email).join(', ')}`, $(`#rf-${k}`));
          });
          if (!composeState.subject.trim()) fail($('#rowSubject'), 'Konu alanı boş bırakılamaz.', $('#cmpSubject'));
          if (!htmlToText(composeState.body).trim()) fail($('#rowBody'), 'Mesaj içeriği boş olamaz.', $('#cmpEditor'));

          if (firstFocus) { firstFocus.focus(); return false; }
          return true;
        }

        function sendMessage() {
          if (composeState.sending || !$('#compose')) return;
          closePops();
          if (!validateCompose()) { showToast('Lütfen işaretli alanları kontrol edin.', 'bi-exclamation-circle'); return; }

          composeState.sending = true;
          clearTimeout(autosaveTimer);
          const btn = $('#cmpSend');
          btn.disabled = true;
          $('.lbl', btn).innerHTML = '<span class="spin"></span> Gönderiliyor…';
          updateStatus('saving');
          $('#cmpStatus .stext').textContent = 'Gönderiliyor…';

          const s = composeState;
          const payload = {
            id: Date.now(),
            to: s.to.map(r => r.email), cc: s.cc.map(r => r.email), bcc: s.bcc.map(r => r.email),
            subject: s.subject.trim(),
            body: s.body + (signatureBlock() ? `<p>--<br>${escapeHtml(prefs.signature.trim()).replace(/\n/g, '<br>')}</p>` : ''),
            attachments: s.files.map(f => ({ name: f.name, size: f.size })),
            sentAt: new Date().toISOString()
          };

          setTimeout(() => {
            sentMessages.unshift(payload);
            const n = payload.to.length + payload.cc.length + payload.bcc.length;
            resetCompose();
            showToast(`Mesajınız ${n} alıcıya başarıyla gönderildi.`, 'bi-send-check');
            if (currentPage === 'compose') renderPage('inbox');
          }, 1300);
        }

        function resetCompose() {
          composeState.files.forEach(f => f.url && URL.revokeObjectURL(f.url));
          clearTimeout(autosaveTimer);
          Object.assign(composeState, {
            to: [], cc: [], bcc: [], showCc: false, showBcc: false,
            subject: '', body: '', files: [], savedAt: null, dirty: false, sending: false
          });
          savedRange = null;
          draftStorage.clear();
        }

        /* --- Temizle (onaylı) --- */
        function openClearDialog() {
          if (isComposeEmpty()) { showToast('Form zaten boş.', 'bi-info-circle'); return; }
          const d = $('#cmpDialog');
          d.hidden = false;
          $('[data-dialog="cancel"]', d).focus();
        }
        function closeClearDialog() { const d = $('#cmpDialog'); if (d) d.hidden = true; }
        function confirmClear() {
          resetCompose();
          renderPage('compose', { pushHash: false });
          showToast('Form temizlendi.', 'bi-eraser');
        }

        /* Compose için genel dinleyiciler (bir kez bağlanır) */
        document.addEventListener('selectionchange', () => {
          if (currentPage !== 'compose') return;
          saveSelection();
          updateToolbarState();
        });
        document.addEventListener('mousedown', e => {
          if (currentPage === 'compose' && !e.target.closest('.tb-wrap')) closePops();
        });
        // Dosya editör dışına bırakılırsa tarayıcının dosyayı açmasını engelle
        ['dragover', 'drop'].forEach(t => window.addEventListener(t, e => {
          if (currentPage === 'compose' && hasFiles(e)) e.preventDefault();
        }));

        /* ======================================================================
           5c. PROFİLİM VIEW  (ileride Views/Account/Profile.cshtml)
           Identity karşılıkları: UserManager.UpdateAsync, SetUserNameAsync,
           SetPhoneNumberAsync, ChangePasswordAsync — hepsi sunucu tarafında yapılacak.
           ====================================================================== */

        /* Hesap tercihleri — localStorage'da saklanır (şifre ASLA saklanmaz) */
        const prefs = Object.assign({
          emailNotifications: true,
          desktopNotifications: false,
          autoSaveDraft: true,
          signatureEnabled: true,
          signature: 'Ahmet Yılmaz\nYazılım Geliştirici · Mailora\n+90 532 418 27 64'
        }, readJSON(PREFS_KEY) || {});
        const savePrefs = () => writeJSON(PREFS_KEY, prefs);

        /* --- Kullanıcıyı Layout'a yansıtma (Navbar, Yeni Mesaj, Gelen Kutusu) --- */
        function userInitials() { return initials(ME.name) || 'U'; }
        function avatarInner() { return profile.photo ? `<img src="${profile.photo}" alt="${escapeHtml(ME.name)}">` : userInitials(); }
        function userAvatar(size = '') { return `<span class="avatar ${size} av-user" data-user="avatar">${avatarInner()}</span>`; }

        function applyProfileToLayout() {
          $$('[data-user="avatar"]').forEach(el => { el.innerHTML = avatarInner(); });
          $$('[data-user="fullName"]').forEach(el => { el.textContent = ME.name; });
          $$('[data-user="firstName"]').forEach(el => { el.textContent = profile.firstName; });
          $$('[data-user="email"]').forEach(el => { el.textContent = ME.email; });
          $$('[data-user="userName"]').forEach(el => { el.textContent = '@@' + profile.userName; });
        }

        function persistProfile() {
          const data = Object.fromEntries(PROFILE_EDITABLE.map(k => [k, profile[k]]));
          data.lastPasswordChange = profile.lastPasswordChange;
          if (!writeJSON(PROFILE_KEY, data)) writeJSON(PROFILE_KEY, Object.assign(data, { photo: null })); // kota dolarsa fotoğrafsız
        }

        function signatureBlock() {
          if (!prefs.signatureEnabled || !prefs.signature.trim()) return '';
          return `
            <div class="cmp-signature">
              <div class="sig-head"><span><i class="bi bi-pen"></i> İmza</span><a href="#profile" data-page="profile">Düzenle</a></div>
              <div class="sig-body">${escapeHtml(prefs.signature.trim())}</div>
            </div>`;
        }

        const fmtLongDate = iso => {
          if (!iso) return '—';
          const [y, m, d] = iso.split('-').map(Number);
          return new Date(y, m - 1, d).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
        };
        const todayIso = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };

        /* Kullanıcıya özel istatistikler — ileride Dashboard / Messages tablosundan (UserId bazlı) gelecek */
        function getProfileStats() {
          return [
            { label: 'Toplam Gönderilen Mesaj', value: mailStats().sent, icon: 'bi-send-check', color: 'av-lav', sub: 'Bu ay 28 mesaj gönderildi', go: 'sent' },
            { label: 'Toplam Alınan Mesaj', value: mailStats().received, icon: 'bi-inbox', color: 'av-blue', sub: 'Son 7 günde 46 yeni mesaj', go: 'inbox', filter: 'all' },
            { label: 'Okunmamış Mesaj', value: messages.filter(m => m.unread).length, icon: 'bi-envelope-exclamation', color: 'av-peach', sub: 'Gelen kutunuzda bekliyor', go: 'inbox', filter: 'unread' },
            { label: 'Yıldızlı Mesaj', value: messages.filter(m => m.starred).length, icon: 'bi-star', color: 'av-sun', sub: 'Önemli olarak işaretlendi', go: 'inbox', filter: 'starred' }
          ];
        }

        /* --- Kişisel bilgiler formu tanımı (name = ileride ViewModel property / asp-for) --- */
        const PF_FIELDS = [
          { key: 'firstName', label: 'Ad', icon: 'bi-person', name: 'FirstName', req: true, attrs: 'autocomplete="given-name" maxlength="50"' },
          { key: 'lastName', label: 'Soyad', icon: 'bi-person', name: 'LastName', req: true, attrs: 'autocomplete="family-name" maxlength="50"' },
          { key: 'userName', label: 'Kullanıcı Adı', icon: 'bi-at', name: 'UserName', req: true, attrs: 'autocomplete="username" maxlength="30" spellcheck="false"', hint: 'Harf, rakam ve . _ - @@ + karakterleri kullanılabilir.' },
          { key: 'email', label: 'E-posta Adresi', icon: 'bi-envelope', name: 'Email', req: true, type: 'email', attrs: 'autocomplete="email" spellcheck="false"', hint: 'Değiştirirseniz yeni adrese doğrulama e-postası gönderilir.' },
          { key: 'phone', label: 'Telefon Numarası', icon: 'bi-telephone', name: 'PhoneNumber', type: 'tel', attrs: 'autocomplete="tel" placeholder="+90 5xx xxx xx xx" maxlength="20"' },
          { key: 'birthDate', label: 'Doğum Tarihi', icon: 'bi-calendar3', name: 'BirthDate', type: 'date', attrs: `max="${todayIso()}"` }
        ];
        const PF_KEYS = [...PF_FIELDS.map(f => f.key), 'about'];

        function validateProfileField(key, raw) {
          const v = String(raw || '').trim();
          switch (key) {
            case 'firstName':
            case 'lastName':
              if (!v) return 'Bu alan zorunludur.';
              if (v.length < 2) return 'En az 2 karakter olmalıdır.';
              if (!/^[\p{L}\s'-]+$/u.test(v)) return 'Yalnızca harf kullanılabilir.';
              return '';
            case 'userName':
              if (!v) return 'Kullanıcı adı zorunludur.';
              if (v.length < 3) return 'En az 3 karakter olmalıdır.';
              if (!/^[a-zA-Z0-9._@@+-]+$/.test(v)) return 'Türkçe karakter ve boşluk kullanılamaz.';
              return '';
            case 'email':
              if (!v) return 'E-posta adresi zorunludur.';
              if (!EMAIL_RE.test(v)) return 'Geçerli bir e-posta adresi girin (ör. ad@alanadi.com).';
              return '';
            case 'phone': {
              if (!v) return '';
              const digits = v.replace(/\D/g, '');
              if (!/^[+\d\s()-]+$/.test(v) || digits.length < 10 || digits.length > 13) return 'Geçerli bir telefon numarası girin.';
              return '';
            }
            case 'birthDate':
              if (!v) return '';
              if (v > todayIso()) return 'Doğum tarihi gelecekte olamaz.';
              if (v < '1900-01-01') return 'Geçerli bir tarih girin.';
              return '';
            case 'about':
              return v.length > 300 ? 'En fazla 300 karakter yazabilirsiniz.' : '';
          }
          return '';
        }

        /* Şifre kuralları — ASP.NET Core Identity PasswordOptions ile uyumlu */
        const PW_RULES = [
          { id: 'len', text: 'En az 8 karakter', test: v => v.length >= 8 },
          { id: 'upper', text: 'En az bir büyük harf', test: v => /[A-ZÇĞİÖŞÜ]/.test(v) },
          { id: 'lower', text: 'En az bir küçük harf', test: v => /[a-zçğıöşü]/.test(v) },
          { id: 'digit', text: 'En az bir rakam', test: v => /\d/.test(v) },
          { id: 'special', text: 'En az bir özel karakter', test: v => /[^A-Za-z0-9ÇĞİÖŞÜçğıöşü\s]/.test(v) },
          { id: 'match', text: 'Şifreler eşleşiyor', test: (v, c) => !!v && v === c }
        ];
        const PW_LEVELS = [
          { t: '', c: 'var(--muted)' },
          { t: 'Zayıf', c: '#C2476B' },
          { t: 'Orta', c: '#C8774A' },
          { t: 'İyi', c: 'var(--accent-dark)' },
          { t: 'Güçlü', c: '#3E9A77' }
        ];

        /* --- Görünüm --- */
        function renderProfileView() {
          const stats = getProfileStats();
          const field = f => `
            <div class="pf-field" data-field="${f.key}">
              <label for="pf-${f.key}">${f.label}${f.req ? ' <span class="req">*</span>' : ''}</label>
              <div class="pf-input-wrap">
                <i class="bi ${f.icon} lead"></i>
                <input id="pf-${f.key}" name="${f.name}" class="pf-input" type="${f.type || 'text'}" value="${escapeHtml(profile[f.key] || '')}" ${f.attrs || ''}>
              </div>
              ${f.hint ? `<div class="pf-hint"><span>${f.hint}</span></div>` : ''}
              <div class="pf-error"></div>
            </div>`;
          const pwField = (key, label, auto, extra = '') => `
            <div class="pf-field" data-field="${key}">
              <label for="pf-${key}">${label} <span class="req">*</span></label>
              <div class="pf-input-wrap">
                <i class="bi bi-lock lead"></i>
                <input id="pf-${key}" class="pf-input has-eye" type="password" autocomplete="${auto}" spellcheck="false">
                <button type="button" class="tool-btn pf-eye" data-eye="pf-${key}" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
              </div>
              <div class="pf-caps"><i class="bi bi-capslock"></i> Caps Lock açık</div>
              ${extra}
              <div class="pf-error"></div>
            </div>`;
          const pref = (key, icon, color, title, desc) => `
            <div class="pf-pref">
              <div class="ic ${color}"><i class="bi ${icon}"></i></div>
              <div class="tx"><div class="t">${title}</div><div class="d">${desc}</div></div>
              <label class="switch" title="${title}">
                <input type="checkbox" data-pref="${key}" ${prefs[key] ? 'checked' : ''} aria-label="${title}">
                <span class="track"></span>
              </label>
            </div>`;

          return `
            <section class="profile" id="profile">

              <div class="pf-head">
                <h1>Profilim</h1>
                <p>Kişisel bilgilerinizi, hesap ayarlarınızı ve güvenlik tercihlerinizi yönetin.</p>
              </div>

              <!-- Profil üst kartı -->
              <div class="pf-hero">
                <div class="pf-cover"><span class="pf-cover-chip"><i class="bi bi-gem"></i> ${profile.plan}</span></div>
                <div class="pf-main">
                  <div class="pf-avatar-wrap">
                    ${userAvatar('pf-avatar')}
                    <button type="button" class="pf-cam" data-photo="change" title="Profil fotoğrafını değiştir" aria-label="Profil fotoğrafını değiştir"><i class="bi bi-camera-fill"></i></button>
                    <input type="file" id="pfPhotoInput" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
                  </div>
                  <div class="pf-id">
                    <div class="pf-name-row">
                      <h2 data-user="fullName">${escapeHtml(ME.name)}</h2>
                      <span class="pf-status">${profile.accountStatus === 'Aktif' ? 'Aktif Hesap' : profile.accountStatus}</span>
                    </div>
                    <div class="pf-username" data-user="userName">@@${escapeHtml(profile.userName)}</div>
                    <div class="pf-meta">
                      <span><i class="bi bi-envelope"></i><span data-user="email">${escapeHtml(profile.email)}</span></span>
                      <span><i class="bi bi-calendar-heart"></i>Üyelik: ${fmtLongDate(profile.createdAt)}</span>
                    </div>
                  </div>
                  <div class="pf-hero-actions">
                    <button type="button" class="btn-soft" data-photo="change"><i class="bi bi-camera"></i> Fotoğrafı Değiştir</button>
                    <button type="button" class="btn-soft danger" data-photo="remove" id="pfPhotoRemove" ${profile.photo ? '' : 'hidden'}><i class="bi bi-trash3"></i> Kaldır</button>
                  </div>
                </div>
              </div>

              <!-- Hesap istatistikleri -->
              <div class="pf-stats">
                ${stats.map(s => `
                  <button type="button" class="pf-stat" data-go="${s.go}" ${s.filter ? `data-filter-go="${s.filter}"` : ''}>
                    <span class="ic ${s.color}"><i class="bi ${s.icon}"></i></span>
                    <span>
                      <span class="num d-block">${s.value.toLocaleString('tr-TR')}</span>
                      <span class="lbl d-block">${s.label}</span>
                      <span class="sub d-block">${s.sub}</span>
                    </span>
                  </button>`).join('')}
              </div>

              <div class="pf-grid">
                <div class="pf-col">

                  <!-- Kişisel bilgiler -->
                  <form class="pf-card" id="pfInfoForm" novalidate autocomplete="on">
                    <div class="pf-card-head">
                      <div class="ic av-lav"><i class="bi bi-person-vcard"></i></div>
                      <div><h3>Kişisel Bilgiler</h3><p>Hesabınızda görünen temel bilgiler</p></div>
                    </div>
                    <div class="pf-card-body">
                      <div class="pf-form-grid">
                        ${PF_FIELDS.map(field).join('')}
                        <div class="pf-field span-2" data-field="about">
                          <label for="pf-about">Hakkımda</label>
                          <textarea id="pf-about" name="About" class="pf-input" rows="4" maxlength="300" placeholder="Kendinizden kısaca bahsedin…">${escapeHtml(profile.about || '')}</textarea>
                          <div class="pf-hint"><span>Profil kartınızda ve kişi önerilerinde görünür.</span><span id="pfAboutCount">0 / 300</span></div>
                          <div class="pf-error"></div>
                        </div>
                      </div>
                    </div>
                    <div class="pf-card-foot">
                      <span class="pf-dirty" id="pfDirty">Tüm değişiklikler kaydedildi</span>
                      <button type="button" class="btn-soft" id="pfReset" disabled><i class="bi bi-arrow-counterclockwise"></i> Vazgeç</button>
                      <button type="submit" class="btn-send" id="pfSave"><span class="lbl"><i class="bi bi-check2-circle"></i> Değişiklikleri Kaydet</span></button>
                    </div>
                  </form>

                  <!-- Hesap tercihleri -->
                  <div class="pf-card">
                    <div class="pf-card-head">
                      <div class="ic av-mint"><i class="bi bi-sliders"></i></div>
                      <div><h3>Hesap Tercihleri</h3><p>Değişiklikler otomatik olarak kaydedilir</p></div>
                    </div>
                    <div class="pf-card-body">
                      ${pref('emailNotifications', 'bi-envelope-paper', 'av-lav', 'E-posta bildirimleri', 'Yeni mesajlar için günlük e-posta özeti gönder')}
                      ${pref('desktopNotifications', 'bi-display', 'av-blue', 'Masaüstü bildirimleri', 'Yeni mesaj geldiğinde tarayıcı bildirimi göster')}
                      ${pref('autoSaveDraft', 'bi-cloud-check', 'av-mint', 'Otomatik taslak kaydetme', 'Yeni Mesaj ekranında yazdıklarınızı otomatik kaydet')}
                      ${pref('signatureEnabled', 'bi-pen', 'av-peach', 'Varsayılan e-posta imzası', 'Yeni mesajların sonuna otomatik eklenir')}
                      <div class="pf-sig">
                        <textarea id="pfSignature" class="pf-input" maxlength="300" rows="3" aria-label="E-posta imzası" ${prefs.signatureEnabled ? '' : 'disabled'}>${escapeHtml(prefs.signature)}</textarea>
                        <div class="pf-hint"><span class="pf-saved" id="pfSigSaved"><i class="bi bi-check2"></i> İmza kaydedildi</span><span id="pfSigCount">0 / 300</span></div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="pf-col">

                  <!-- Hesap güvenliği -->
                  <form class="pf-card" id="pfPassForm" novalidate>
                    <input type="text" name="username" autocomplete="username" value="${escapeHtml(profile.userName)}" hidden>
                    <div class="pf-card-head">
                      <div class="ic av-rose"><i class="bi bi-shield-lock"></i></div>
                      <div><h3>Hesap Güvenliği</h3><p>Şifrenizi düzenli olarak değiştirin</p></div>
                    </div>
                    <div class="pf-card-body">
                      <div class="pf-stack">
                        ${pwField('currentPassword', 'Mevcut Şifre', 'current-password')}
                        ${pwField('newPassword', 'Yeni Şifre', 'new-password', `
                          <div class="pf-strength" id="pfStrength" data-level="0"><span></span><span></span><span></span><span></span></div>
                          <div class="pf-strength-label"><span>Şifre gücü</span><b id="pfStrengthText">—</b></div>`)}
                        ${pwField('confirmPassword', 'Yeni Şifre Tekrar', 'new-password')}
                      </div>
                      <ul class="pf-rules" id="pfRules">
                        ${PW_RULES.map(r => `<li data-rule="${r.id}"><i class="bi bi-circle"></i>${r.text}</li>`).join('')}
                      </ul>
                      <div class="pf-note"><i class="bi bi-info-circle-fill"></i><span>Şifreniz bu cihazda saklanmaz. Mevcut şifre doğrulaması ve güncelleme işlemi sunucu tarafında güvenli şekilde yapılır.</span></div>
                    </div>
                    <div class="pf-card-foot">
                      <span class="pf-lastpw"><i class="bi bi-clock-history"></i> Son değişiklik: <span id="pfLastPw">${fmtLongDate(profile.lastPasswordChange)}</span></span>
                      <button type="submit" class="btn-send" id="pfPassSave"><span class="lbl"><i class="bi bi-shield-check"></i> Şifremi Güncelle</span></button>
                    </div>
                  </form>

                  <!-- Hesap durumu (Identity alanları) -->
                  <div class="pf-card">
                    <div class="pf-card-head">
                      <div class="ic av-blue"><i class="bi bi-person-check"></i></div>
                      <div><h3>Hesap Durumu</h3><p>Doğrulama ve güvenlik özeti</p></div>
                    </div>
                    <div class="pf-card-body">
                      <ul class="pf-list">
                        <li><span class="k"><i class="bi bi-fingerprint"></i> Kullanıcı ID</span><span class="v">${profile.id}</span></li>
                        <li><span class="k"><i class="bi bi-envelope-check"></i> E-posta doğrulama</span><span class="v">${profile.emailConfirmed ? '<span class="pf-badge ok"><i class="bi bi-check2"></i> Doğrulandı</span>' : '<span class="pf-badge warn">Bekliyor</span>'}</span></li>
                        <li><span class="k"><i class="bi bi-phone"></i> Telefon doğrulama</span><span class="v">${profile.phoneConfirmed ? '<span class="pf-badge ok">Doğrulandı</span>' : '<span class="pf-badge warn">Doğrulanmadı</span><button type="button" class="link-btn" data-soon="Telefon doğrulama">Doğrula</button>'}</span></li>
                        <li><span class="k"><i class="bi bi-shield-check"></i> İki adımlı doğrulama</span><span class="v">${profile.twoFactorEnabled ? '<span class="pf-badge ok">Açık</span>' : '<span class="pf-badge off">Kapalı</span><button type="button" class="link-btn" data-soon="İki adımlı doğrulama">Etkinleştir</button>'}</span></li>
                        <li><span class="k"><i class="bi bi-gem"></i> Hesap türü</span><span class="v">${profile.plan}</span></li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

            </section>`;
        }

        function initProfileView() {
          bindProfileHero();
          bindInfoForm();
          bindPasswordForm();
          bindPrefs();
          $$('#profile [data-soon]').forEach(b => b.addEventListener('click', () =>
            showToast(`${b.dataset.soon} Identity entegrasyonu ile eklenecek.`, 'bi-hourglass-split')));
          $$('#profile [data-go]').forEach(b => b.addEventListener('click', () => {
            if (b.dataset.filterGo) { inboxState.filter = b.dataset.filterGo; inboxState.label = null; inboxState.page = 1; }
            renderPage(b.dataset.go);
          }));
        }

        /* --- Profil fotoğrafı (yalnızca tarayıcıda; 256px'e küçültülür) --- */
        function bindProfileHero() {
          const input = $('#pfPhotoInput');
          $$('#profile [data-photo="change"]').forEach(b => b.addEventListener('click', () => input.click()));
          $('#pfPhotoRemove').addEventListener('click', () => {
            profile.photo = null;
            persistProfile(); applyProfileToLayout();
            $('#pfPhotoRemove').hidden = true;
            showToast('Profil fotoğrafı kaldırıldı.', 'bi-person-circle');
          });
          input.addEventListener('change', () => {
            const file = input.files[0];
            input.value = '';
            if (!file) return;
            if (!file.type.startsWith('image/')) { showToast('Lütfen bir görsel dosyası seçin.', 'bi-exclamation-circle'); return; }
            if (file.size > 5 * 1024 * 1024) { showToast('Fotoğraf en fazla 5 MB olabilir.', 'bi-exclamation-circle'); return; }
            const url = URL.createObjectURL(file);
            const img = new Image();
            img.onload = () => {
              const size = 256, c = document.createElement('canvas');
              c.width = c.height = size;
              const s = Math.min(img.width, img.height);
              c.getContext('2d').drawImage(img, (img.width - s) / 2, (img.height - s) / 2, s, s, 0, 0, size, size);
              URL.revokeObjectURL(url);
              profile.photo = c.toDataURL('image/jpeg', .88);
              persistProfile(); applyProfileToLayout();
              const rm = $('#pfPhotoRemove'); if (rm) rm.hidden = false;
              showToast('Profil fotoğrafınız güncellendi.', 'bi-camera');
            };
            img.onerror = () => { URL.revokeObjectURL(url); showToast('Görsel okunamadı.', 'bi-exclamation-circle'); };
            img.src = url;
          });
        }

        /* --- Kişisel bilgiler --- */
        function setPfError(key, msg) {
          const f = $(`#profile [data-field="${key}"]`);
          if (!f) return;
          f.classList.toggle('has-error', !!msg);
          $('.pf-error', f).textContent = msg || '';
        }
        function collectInfo() { return Object.fromEntries(PF_KEYS.map(k => [k, $(`#pf-${k}`).value])); }
        function isInfoDirty() { const d = collectInfo(); return PF_KEYS.some(k => d[k].trim() !== String(profile[k] || '').trim()); }

        function updateInfoDirty() {
          const dirty = isInfoDirty(), el = $('#pfDirty');
          if (!el) return;
          el.classList.toggle('is-dirty', dirty);
          el.textContent = dirty ? 'Kaydedilmemiş değişiklikler var' : 'Tüm değişiklikler kaydedildi';
          $('#pfReset').disabled = !dirty;
          $('#pfAboutCount').textContent = `${$('#pf-about').value.length} / 300`;
        }

        function bindInfoForm() {
          const form = $('#pfInfoForm');
          PF_KEYS.forEach(k => {
            const el = $(`#pf-${k}`);
            el.addEventListener('input', () => {
              if (k === 'phone') el.value = el.value.replace(/[^\d+\s()-]/g, '');
              if (k === 'userName') el.value = el.value.replace(/\s/g, '');
              if ($(`#profile [data-field="${k}"]`).classList.contains('has-error')) setPfError(k, validateProfileField(k, el.value));
              updateInfoDirty();
            });
            el.addEventListener('blur', () => setPfError(k, validateProfileField(k, el.value)));
          });
          $('#pfReset').addEventListener('click', () => {
            PF_KEYS.forEach(k => { $(`#pf-${k}`).value = profile[k] || ''; setPfError(k, ''); });
            updateInfoDirty();
            showToast('Değişiklikler geri alındı.', 'bi-arrow-counterclockwise');
          });
          form.addEventListener('submit', e => { e.preventDefault(); saveProfile(); });
          updateInfoDirty();
        }

        function saveProfile() {
          const data = collectInfo();
          let first = null;
          PF_KEYS.forEach(k => {
            const err = validateProfileField(k, data[k]);
            setPfError(k, err);
            if (err && !first) first = k;
          });
          if (first) { $(`#pf-${first}`).focus(); showToast('Lütfen işaretli alanları düzeltin.', 'bi-exclamation-circle'); return; }
          if (!isInfoDirty()) { showToast('Kaydedilecek bir değişiklik yok.', 'bi-info-circle'); return; }

          const btn = $('#pfSave'), lbl = $('.lbl', btn), old = lbl.innerHTML;
          btn.disabled = true; lbl.innerHTML = '<span class="spin"></span> Kaydediliyor…';
          setTimeout(() => {
            PF_KEYS.forEach(k => { profile[k] = data[k].trim(); });
            persistProfile();
            applyProfileToLayout();
            if ($('#pfInfoForm')) {
              PF_KEYS.forEach(k => { $(`#pf-${k}`).value = profile[k]; });
              btn.disabled = false; lbl.innerHTML = old;
              updateInfoDirty();
            }
            showToast('Profil bilgileriniz başarıyla güncellendi.', 'bi-person-check');
          }, 750);
        }

        /* --- Şifre değiştirme (yalnızca frontend doğrulama + simülasyon) --- */
        function updatePasswordUi() {
          const v = $('#pf-newPassword').value, c = $('#pf-confirmPassword').value;
          PW_RULES.forEach(r => {
            const li = $(`#pfRules [data-rule="${r.id}"]`), ok = r.test(v, c);
            li.classList.toggle('ok', ok);
            $('i', li).className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
          });
          const passed = PW_RULES.slice(0, 5).filter(r => r.test(v)).length;
          const level = !v ? 0 : passed <= 2 ? 1 : passed === 3 ? 2 : passed === 4 ? 3 : 4;
          $('#pfStrength').dataset.level = level;
          const t = $('#pfStrengthText');
          t.textContent = PW_LEVELS[level].t || '—';
          t.style.color = PW_LEVELS[level].c;
        }

        function bindPasswordForm() {
          const form = $('#pfPassForm');
          $$('[data-eye]', form).forEach(b => b.addEventListener('click', () => {
            const input = $('#' + b.dataset.eye), show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            $('i', b).className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            b.title = show ? 'Şifreyi gizle' : 'Şifreyi göster';
            b.setAttribute('aria-label', b.title);
          }));
          ['currentPassword', 'newPassword', 'confirmPassword'].forEach(k => {
            const el = $(`#pf-${k}`);
            el.addEventListener('input', () => {
              if (k !== 'currentPassword') updatePasswordUi();
              setPfError(k, '');
              if (k === 'newPassword' && $('#pf-confirmPassword').value) setPfError('confirmPassword', '');
            });
            el.addEventListener('keyup', e => {
              const caps = e.getModifierState && e.getModifierState('CapsLock');
              $('.pf-caps', el.closest('.pf-field')).classList.toggle('show', !!caps);
            });
            el.addEventListener('blur', () => $('.pf-caps', el.closest('.pf-field')).classList.remove('show'));
          });
          $('#pf-confirmPassword').addEventListener('blur', () => {
            const c = $('#pf-confirmPassword').value;
            if (c && c !== $('#pf-newPassword').value) setPfError('confirmPassword', 'Şifreler eşleşmiyor.');
          });
          form.addEventListener('submit', e => { e.preventDefault(); changePassword(); });
          updatePasswordUi();
        }

        function changePassword() {
          const cur = $('#pf-currentPassword').value, nw = $('#pf-newPassword').value, cf = $('#pf-confirmPassword').value;
          const errs = {};
          if (!cur) errs.currentPassword = 'Mevcut şifrenizi girin.';
          if (!nw) errs.newPassword = 'Yeni şifrenizi girin.';
          else if (!PW_RULES.slice(0, 5).every(r => r.test(nw))) errs.newPassword = 'Yeni şifre aşağıdaki kuralların tamamını karşılamalıdır.';
          else if (cur && nw === cur) errs.newPassword = 'Yeni şifre mevcut şifrenizden farklı olmalıdır.';
          if (!cf) errs.confirmPassword = 'Yeni şifrenizi tekrar girin.';
          else if (nw !== cf) errs.confirmPassword = 'Şifreler eşleşmiyor.';

          ['currentPassword', 'newPassword', 'confirmPassword'].forEach(k => setPfError(k, errs[k] || ''));
          const first = Object.keys(errs)[0];
          if (first) { $(`#pf-${first}`).focus(); showToast('Şifre bilgilerini kontrol edin.', 'bi-exclamation-circle'); return; }

          const btn = $('#pfPassSave'), lbl = $('.lbl', btn), old = lbl.innerHTML;
          btn.disabled = true; lbl.innerHTML = '<span class="spin"></span> Güncelleniyor…';
          // Gerçek uygulamada: POST /Account/ChangePassword → UserManager.ChangePasswordAsync(user, current, new)
          setTimeout(() => {
            profile.lastPasswordChange = todayIso();
            persistProfile();
            if ($('#pfPassForm')) {
              ['currentPassword', 'newPassword', 'confirmPassword'].forEach(k => {
                const el = $(`#pf-${k}`); el.value = ''; el.type = 'password';
              });
              $$('#pfPassForm [data-eye] i').forEach(i => { i.className = 'bi bi-eye'; });
              updatePasswordUi();
              $('#pfLastPw').textContent = fmtLongDate(profile.lastPasswordChange);
              btn.disabled = false; lbl.innerHTML = old;
            }
            showToast('Şifreniz başarıyla güncellendi.', 'bi-shield-check');
          }, 1000);
        }

        /* --- Tercihler (toggle switch + imza) --- */
        function bindPrefs() {
          const labels = {
            emailNotifications: 'E-posta bildirimleri',
            desktopNotifications: 'Masaüstü bildirimleri',
            autoSaveDraft: 'Otomatik taslak kaydetme',
            signatureEnabled: 'Varsayılan imza'
          };
          $$('#profile [data-pref]').forEach(input => input.addEventListener('change', () => {
            const key = input.dataset.pref, on = input.checked;

            if (key === 'desktopNotifications' && on) {
              if (!('Notification' in window)) {
                input.checked = false; showToast('Tarayıcınız masaüstü bildirimlerini desteklemiyor.', 'bi-exclamation-circle'); return;
              }
              Notification.requestPermission().then(p => {
                if (p === 'granted') {
                  prefs.desktopNotifications = true; savePrefs();
                  try { new Notification('Mailora', { body: 'Masaüstü bildirimleri etkinleştirildi.' }); } catch (e) { /* yok say */ }
                  showToast('Masaüstü bildirimleri açıldı.', 'bi-bell');
                } else {
                  input.checked = false; prefs.desktopNotifications = false; savePrefs();
                  showToast('Bildirim izni verilmedi. Tarayıcı ayarlarından izin verebilirsiniz.', 'bi-bell-slash');
                }
              });
              return;
            }

            prefs[key] = on;
            savePrefs();
            if (key === 'signatureEnabled') $('#pfSignature').disabled = !on;
            showToast(`${labels[key]} ${on ? 'açıldı' : 'kapatıldı'}.`, on ? 'bi-toggle-on' : 'bi-toggle-off');
          }));

          const sig = $('#pfSignature'), count = $('#pfSigCount'), saved = $('#pfSigSaved');
          let t = null;
          count.textContent = `${sig.value.length} / 300`;
          sig.addEventListener('input', () => {
            count.textContent = `${sig.value.length} / 300`;
            saved.classList.remove('show');
            clearTimeout(t);
            t = setTimeout(() => {
              prefs.signature = sig.value;
              savePrefs();
              if (document.body.contains(saved)) saved.classList.add('show');
            }, 600);
          });
        }

        /* ======================================================================
           5d. DASHBOARD VIEW  (ileride Views/Dashboard/Index.cshtml)
           Her kart ileride bir View Component olabilir:
           WelcomeViewComponent, StatCardsViewComponent, TrafficChartViewComponent,
           MessageDistributionViewComponent, RecentMessagesViewComponent, TopContactsViewComponent
           ====================================================================== */

        /* --- Veri katmanı: ileride DashboardService + LINQ sorgularıyla değişecek --- */
        const ARCHIVE = { received: 1270, sent: 342 };  // Gelen kutusunda listelenmeyen eski mesajlar (temsili)
        const DRAFT_COUNT = 3;                            // Sidebar'daki Taslaklar rozetiyle aynı
        const LAST_LOGIN = { time: '09:02', device: 'Chrome · Windows' };
        const isTodayTime = t => /^\d{1,2}:\d{2}$/.test(t);  // Örnek veride bugünkü mesajlar "10:42" biçiminde

        /* Tüm sayfalar (Dashboard, Profilim) bu tek kaynaktan beslenir */
        function mailStats() {
          return {
            received: ARCHIVE.received + messages.length,               // Messages.Count(m => m.ReceiverId == userId)
            sent: ARCHIVE.sent + sentMessages.length,                   // Messages.Count(m => m.SenderId == userId)
            inbox: messages.length,
            read: messages.filter(m => !m.unread).length,               // Count(m => m.IsRead)
            unread: messages.filter(m => m.unread).length,              // Count(m => !m.IsRead)
            starred: messages.filter(m => m.starred).length,            // Count(m => m.IsStarred)
            starredUnread: messages.filter(m => m.starred && m.unread).length,
            drafts: DRAFT_COUNT,                                        // Drafts.Count(d => d.UserId == userId)
            todayReceived: messages.filter(m => isTodayTime(m.time)).length // Count(m => m.Date.Date == DateTime.Today)
          };
        }

        /* Tekrarlanabilir temsili trafik verisi: 90 gün bir kez üretilir,
           7 ve 30 günlük görünümler bunun son kısmıdır (filtreler arası tutarlılık). */
        function seededRandom(seed) {
          return () => {
            seed = (seed + 0x6D2B79F5) | 0;
            let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }
        let trafficBase = null;
        function buildTrafficBase() {
          const rnd = seededRandom(20261106), days = 90, out = [];
          const today = new Date(); today.setHours(0, 0, 0, 0);
          for (let i = days - 1; i >= 0; i--) {
            const d = new Date(today); d.setDate(today.getDate() - i);
            const weekend = d.getDay() === 0 || d.getDay() === 6;
            const trend = 1 + ((days - i) / days) * .25;
            out.push({
              date: d,
              inc: Math.round((weekend ? 4 : 10) * trend + rnd() * (weekend ? 3 : 6)),
              sent: Math.round((weekend ? .5 : 2.5) * trend + rnd() * (weekend ? 1.5 : 3))
            });
          }
          return out;
        }

        /* Messages.Where(m => m.Date >= from).GroupBy(m => m.Date.Date).Select(g => new { g.Key, Count = g.Count() }) */
        function getTraffic(range) {
          if (!trafficBase) trafficBase = buildTrafficBase();
          const pts = trafficBase.slice(-range).map(p => ({ ...p }));
          const last = pts[pts.length - 1];
          last.inc = mailStats().todayReceived;                       // bugün: gelen kutusundaki gerçek veri
          last.sent += sentMessages.filter(m => new Date(m.sentAt).toDateString() === last.date.toDateString()).length;
          const fmt = range === 7
            ? d => d.toLocaleDateString('tr-TR', { weekday: 'short', day: 'numeric' })
            : d => d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' });
          return {
            labels: pts.map(p => fmt(p.date)),
            inc: pts.map(p => p.inc),
            sent: pts.map(p => p.sent),
            totalInc: pts.reduce((s, p) => s + p.inc, 0),
            totalSent: pts.reduce((s, p) => s + p.sent, 0)
          };
        }

        /* Birbirini dışlayan durumlar: Okunmuş + Okunmamış (gelen kutusu) + Taslak.
           Yıldızlı mesajlar bunlarla örtüştüğü için ayrı gösterge olarak sunulur. */
        function getDistribution() {
          const s = mailStats();
          return [
            { label: 'Okunmuş', value: s.read, color: '#8B7FD6' },
            { label: 'Okunmamış', value: s.unread, color: '#7FB2F0' },
            { label: 'Taslak', value: s.drafts, color: '#7DD3B0' }
          ];
        }

        /* Messages.GroupBy(m => m.ContactEmail).OrderByDescending(g => g.Count()).Take(5) */
        const CONTACT_TOTALS = {
          'ayse.demir@novatek.com.tr': 128, 'mehmet.kaya@novatek.com.tr': 96, 'selin@studiopastel.co': 74,
          'burak.sahin@novatek.com.tr': 61, 'elif.celik@novatek.com.tr': 48
        };
        function getTopContacts(n = 5) {
          return contacts.filter(c => CONTACT_TOTALS[c.email])
            .map(c => ({ ...c, total: CONTACT_TOTALS[c.email] }))
            .sort((a, b) => b.total - a.total).slice(0, n);
        }

        function greeting() {
          const h = new Date().getHours();
          return h < 5 ? 'İyi geceler' : h < 12 ? 'Günaydın' : h < 18 ? 'İyi günler' : h < 22 ? 'İyi akşamlar' : 'İyi geceler';
        }

