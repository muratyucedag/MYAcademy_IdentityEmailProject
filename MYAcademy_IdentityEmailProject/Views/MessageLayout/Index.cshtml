        let currentPage = null;

        /* ======================================================================
           4. renderPage(pageName) — LAYOUT ROUTER
           - Sidebar ve Navbar'a dokunmaz.
           - Yalnızca #mainContent içeriğini değiştirir.
           - Aktif menüyü günceller, sayfa yenilemez.
           ====================================================================== */
        function renderPage(pageName, { pushHash = true, param = null } = {}) {
          const page = pages[pageName] ? pageName : 'inbox';
          const def = pages[page];
          const main = $('#mainContent');

          // Önceki sayfanın kaynaklarını temizle (ör. Chart.js örnekleri)
          if (currentPage && pages[currentPage].destroy) pages[currentPage].destroy();

          main.innerHTML = def.render ? def.render(param) : renderPlaceholder(def);
          main.classList.remove('page-enter');
          void main.offsetWidth;            // animasyonu yeniden tetikle
          main.classList.add('page-enter');

          currentPage = page;
          if (def.init) def.init(param);

          setActiveMenu(def.menu || page);       // ör. Mesaj detayında "Gelen Kutusu" aktif kalır
          document.title = `${typeof def.title === 'function' ? def.title(param) : def.title} · Mailora`;

          const hash = '#' + page + (param != null ? '/' + param : '');
          if (pushHash && location.hash !== hash) history.pushState(null, '', hash);
          closeSidebar();
          window.scrollTo(0, 0);
        }

        /* Adres çubuğundaki hash'ten sayfayı aç: #inbox, #message/3 … */
        function routeFromHash() {
          const [name, param] = location.hash.slice(1).split('/');
          renderPage(name || 'inbox', { pushHash: false, param: param ? decodeURIComponent(param) : null });
        }

        function setActiveMenu(page) {
          $$('.side-link').forEach(a => a.classList.toggle('active', a.dataset.page === page));
        }

        function renderPlaceholder(def) {
          return `
            <section class="placeholder-wrap">
              <div class="ph-card">
                <div class="ph-icon"><i class="bi ${def.placeholder.icon}"></i></div>
                <span class="ph-kicker"><i class="bi bi-stars"></i> Yakında</span>
                <h2>${def.title}</h2>
                <p>Bu sayfa yakında hazırlanacak. ${def.placeholder.text}</p>
                <div class="ph-progress"><span></span></div>
                <button class="btn-soft primary" type="button" data-page="inbox"><i class="bi bi-inbox"></i> Gelen Kutusuna Dön</button>
              </div>
            </section>`;
        }

        /* ======================================================================
           5. GELEN KUTUSU VIEW  (ileride Views/Inbox/Index.cshtml)
           ====================================================================== */
        function renderInboxView() {
          return `
            <section class="inbox" id="inbox">

              <!-- Mesaj Listesi (Main Content'in tamamını kaplar) -->
              <div class="panel list-panel">
                <div class="list-head">
                  <div class="list-title">
                    <div>
                      <h1>Gelen Kutusu</h1>
                      <div class="sub" id="inboxSub"></div>
                    </div>
                    <span class="count-pill" id="unreadPill"></span>
                  </div>

                  <div class="list-tools">
                    <div class="list-search" id="listSearchWrap">
                      <i class="bi bi-search"></i>
                      <input type="text" id="listSearch" placeholder="Gönderen, konu veya içerik ara" autocomplete="off">
                      <button class="clear" id="listSearchClear" type="button" aria-label="Temizle"><i class="bi bi-x-circle-fill"></i></button>
                    </div>
                    <div class="filter-chips" id="filterChips"></div>
                  </div>
                </div>

                <div class="bulk-bar">
                  <input type="checkbox" class="m-check" id="checkAll" aria-label="Tümünü seç">
                  <span class="sel-info" id="selInfo">Tümünü seç</span>
                  <span class="spacer"></span>
                  <button class="tool-btn" id="bulkRead" title="Okundu olarak işaretle"><i class="bi bi-envelope-open"></i></button>
                  <button class="tool-btn" id="bulkUnread" title="Okunmadı olarak işaretle"><i class="bi bi-envelope"></i></button>
                  <button class="tool-btn" id="bulkDelete" title="Sil"><i class="bi bi-trash3"></i></button>
                  <button class="tool-btn" id="refreshBtn" title="Yenile"><i class="bi bi-arrow-clockwise"></i></button>
                </div>

                <div class="msg-list" id="msgList"></div>

                <div class="list-foot">
                  <span class="range" id="rangeInfo"></span>
                  <div class="pager" id="pager"></div>
                </div>
              </div>

            </section>`;
        }

        function initInboxView() {
          const search = $('#listSearch');
          search.value = inboxState.query;
          $('#listSearchWrap').classList.toggle('has-value', !!inboxState.query);

          search.addEventListener('input', e => setQuery(e.target.value, 'list'));
          $('#listSearchClear').addEventListener('click', () => { setQuery('', 'list'); search.focus(); });

          $('#checkAll').addEventListener('change', e => {
            const ids = getPageItems().map(m => m.id);
            ids.forEach(id => e.target.checked ? inboxState.checked.add(id) : inboxState.checked.delete(id));
            renderList();
          });

          $('#bulkRead').addEventListener('click', () => bulkMark(false));
          $('#bulkUnread').addEventListener('click', () => bulkMark(true));
          $('#bulkDelete').addEventListener('click', bulkDelete);
          $('#refreshBtn').addEventListener('click', e => {
            const ic = e.currentTarget.querySelector('i');
            ic.style.transition = 'transform .6s';
            ic.style.transform = 'rotate(360deg)';
            setTimeout(() => { ic.style.transition = 'none'; ic.style.transform = ''; }, 650);
            showToast('Gelen kutusu güncel.', 'bi-arrow-clockwise');
          });

          renderChips();
          renderList();
        }

        /* --- Filtreleme & sayfalama --- */
        function getFiltered() {
          const q = norm(inboxState.query.trim());
          return messages.filter(m => {
            if (inboxState.filter === 'unread' && !m.unread) return false;
            if (inboxState.filter === 'starred' && !m.starred) return false;
            if (inboxState.filter === 'attach' && !(m.attachments && m.attachments.length)) return false;
            if (inboxState.label && m.label !== inboxState.label) return false;
            if (q && !norm(`${m.name} ${m.email} ${m.subject} ${m.snippet}`).includes(q)) return false;
            return true;
          });
        }

        function getPageCount(list = getFiltered()) {
          return Math.max(1, Math.ceil(list.length / inboxState.perPage));
        }

        function getPageItems() {
          const list = getFiltered();
          inboxState.page = Math.min(inboxState.page, getPageCount(list));
          const start = (inboxState.page - 1) * inboxState.perPage;
          return list.slice(start, start + inboxState.perPage);
        }

        function setQuery(value, source) {
          inboxState.query = value;
          inboxState.page = 1;
          const g = $('#globalSearch');
          if (source !== 'global' && g) g.value = value;
          const l = $('#listSearch');
          if (l && source !== 'list') l.value = value;
          if ($('#listSearchWrap')) $('#listSearchWrap').classList.toggle('has-value', !!value);
          if (currentPage === 'inbox') renderList();
        }

        /* --- Filtre çipleri --- */
        function renderChips() {
          if (!$('#filterChips')) return;
          const c = {
            all: messages.length,
            unread: messages.filter(m => m.unread).length,
            starred: messages.filter(m => m.starred).length,
            attach: messages.filter(m => m.attachments && m.attachments.length).length
          };
          const chips = [
            ['all', 'Tümü', 'bi-inbox'],
            ['unread', 'Okunmamış', 'bi-circle-fill'],
            ['starred', 'Yıldızlı', 'bi-star-fill'],
            ['attach', 'Ekli', 'bi-paperclip']
          ];
          let html = chips.map(([k, t]) =>
            `<button class="chip ${inboxState.filter === k ? 'active' : ''}" data-filter="${k}">${t} <span class="n">${c[k]}</span></button>`
          ).join('');
          if (inboxState.label) {
            html += `<button class="chip active" data-clear-label="1"><i class="bi bi-tag-fill"></i> ${inboxState.label} <i class="bi bi-x"></i></button>`;
          }
          const wrap = $('#filterChips');
          wrap.innerHTML = html;
          $$('[data-filter]', wrap).forEach(b => b.addEventListener('click', () => {
            inboxState.filter = b.dataset.filter; inboxState.page = 1; renderChips(); renderList();
          }));
          const cl = $('[data-clear-label]', wrap);
          if (cl) cl.addEventListener('click', () => { inboxState.label = null; inboxState.page = 1; renderChips(); renderList(); });
        }

        /* --- Mesaj listesi --- */
        function renderList() {
          const listEl = $('#msgList');
          if (!listEl) return;
          const all = getFiltered();
          const items = getPageItems();
          const unread = messages.filter(m => m.unread).length;

          $('#inboxSub').textContent = `${messages.length} mesaj · ${ME.email}`;
          $('#unreadPill').textContent = `${unread} okunmamış`;

          if (!items.length) {
            listEl.innerHTML = `
              <div class="empty-list">
                <div class="ic"><i class="bi bi-search-heart"></i></div>
                <h6>Sonuç bulunamadı</h6>
                <div>Arama veya filtre kriterlerini değiştirmeyi deneyin.</div>
              </div>`;
          } else {
            listEl.innerHTML = items.map(m => {
              const checked = inboxState.checked.has(m.id);
              const hasAtt = m.attachments && m.attachments.length;
              return `
                <article class="msg-item ${m.unread ? 'unread' : ''} ${m.id === inboxState.selectedId ? 'selected' : ''} ${checked ? 'checked' : ''}" data-id="${m.id}" tabindex="0" title="Mesajı aç">
                  <div class="lead">
                    <input type="checkbox" class="m-check row-check" ${checked ? 'checked' : ''} aria-label="Seç">
                    <button class="star-btn ${m.starred ? 'on' : ''}" type="button" aria-label="Yıldızla"><i class="bi ${m.starred ? 'bi-star-fill' : 'bi-star'}"></i></button>
                  </div>
                  <span class="avatar ${m.color}">${initials(m.name)}</span>
                  <div class="mi-sender">
                    <span class="sender">${escapeHtml(m.name)}</span>
                    ${m.unread ? '<span class="unread-dot"></span>' : ''}
                  </div>
                  <div class="mi-main"><span class="subject">${escapeHtml(m.subject)}</span><span class="snippet">${escapeHtml(m.snippet)}</span></div>
                  <div class="mi-meta">
                    <span class="tag ${labelClass[m.label] || 'tag-sistem'}">${m.label}</span>
                    ${hasAtt ? `<i class="bi bi-paperclip attach-ic" title="${m.attachments.length} ek"></i>` : ''}
                  </div>
                  <span class="time">${m.time}</span>
                </article>`;
            }).join('');
          }

          // Olaylar
          $$('.msg-item', listEl).forEach(el => {
            const id = +el.dataset.id;
            el.addEventListener('click', e => {
              if (e.target.closest('.row-check') || e.target.closest('.star-btn')) return;
              openMessage(id);
            });
            el.addEventListener('keydown', e => { if (e.key === 'Enter') openMessage(id); });
            $('.row-check', el).addEventListener('change', e => {
              e.target.checked ? inboxState.checked.add(id) : inboxState.checked.delete(id);
              el.classList.toggle('checked', e.target.checked);
              updateBulkBar();
            });
            $('.star-btn', el).addEventListener('click', e => { e.stopPropagation(); toggleStar(id, e.currentTarget); });
          });

          // Sayfalama
          const pc = getPageCount(all);
          const start = all.length ? (inboxState.page - 1) * inboxState.perPage + 1 : 0;
          const end = Math.min(inboxState.page * inboxState.perPage, all.length);
          $('#rangeInfo').textContent = `${start}–${end} / ${all.length} mesaj`;

          let pagerHtml = `<button data-p="prev" ${inboxState.page === 1 ? 'disabled' : ''} aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>`;
          for (let i = 1; i <= pc; i++) pagerHtml += `<button data-p="${i}" class="${i === inboxState.page ? 'active' : ''}">${i}</button>`;
          pagerHtml += `<button data-p="next" ${inboxState.page === pc ? 'disabled' : ''} aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>`;
          const pager = $('#pager');
          pager.innerHTML = pagerHtml;
          $$('button', pager).forEach(b => b.addEventListener('click', () => {
            const p = b.dataset.p;
            inboxState.page = p === 'prev' ? inboxState.page - 1 : p === 'next' ? inboxState.page + 1 : +p;
            renderList();
            listEl.scrollTop = 0;
          }));

          updateBulkBar();
          updateBadges();
        }

        function updateBulkBar() {
          const ids = getPageItems().map(m => m.id);
          const n = inboxState.checked.size;
          const onPage = ids.filter(id => inboxState.checked.has(id)).length;
          const all = $('#checkAll');
          if (!all) return;
          all.checked = ids.length > 0 && onPage === ids.length;
          all.indeterminate = onPage > 0 && onPage < ids.length;
          $('#selInfo').textContent = n ? `${n} mesaj seçildi` : 'Tümünü seç';
          ['#bulkRead', '#bulkUnread', '#bulkDelete'].forEach(s => $(s).disabled = !n);
        }

        /* --- Mesaj işlemleri --- */
        // Mesaja tıklayınca ayrı Mesaj Detay sayfası açılır (#message/{id})
        function openMessage(id, { keepNav = false } = {}) {
          const m = messages.find(x => x.id === id);
          if (!m) return;
          if (!keepNav) inboxState.navList = getFiltered().map(x => x.id);   // gezinme sırası (filtreye göre)
          inboxState.selectedId = id;
          const fi = getFiltered().findIndex(x => x.id === id);
          if (fi > -1) inboxState.page = Math.floor(fi / inboxState.perPage) + 1;   // geri dönünce aynı sayfa
          m.unread = false;
          renderPage('message', { param: id });
        }

        function toggleStar(id, btn) {
          const m = messages.find(x => x.id === id);
          if (!m) return;
          m.starred = !m.starred;
          if (btn) { btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop'); }
          renderChips();
          renderList();
          if (currentPage === 'message') refreshMessagePage();
          updateBadges();
          showToast(m.starred ? 'Mesaj yıldızlandı.' : 'Yıldız kaldırıldı.', m.starred ? 'bi-star-fill' : 'bi-star');
        }

        function deleteMessages(ids) {
          const removed = [];
          ids.forEach(id => {
            const i = messages.findIndex(m => m.id === id);
            if (i > -1) removed.push({ msg: messages.splice(i, 1)[0], index: i });
            inboxState.checked.delete(id);
          });
          removed.forEach(r => trash.push(r.msg));
          if (ids.includes(inboxState.selectedId)) inboxState.selectedId = null;
          renderChips(); renderList(); updateBadges();

          showToast(removed.length > 1 ? `${removed.length} mesaj çöp kutusuna taşındı.` : 'Mesaj çöp kutusuna taşındı.', 'bi-trash3', {
            label: 'Geri Al',
            onClick: () => {
              removed.sort((a, b) => a.index - b.index).forEach(r => {
                messages.splice(r.index, 0, r.msg);
                const t = trash.indexOf(r.msg); if (t > -1) trash.splice(t, 1);
              });
              if (currentPage === 'inbox') { renderChips(); renderList(); }
              updateBadges();
              showToast('İşlem geri alındı.', 'bi-arrow-counterclockwise');
            }
          });
        }

        function bulkMark(unread) {
          inboxState.checked.forEach(id => { const m = messages.find(x => x.id === id); if (m) m.unread = unread; });
          const n = inboxState.checked.size;
          inboxState.checked.clear();
          renderChips(); renderList();
          showToast(`${n} mesaj ${unread ? 'okunmadı' : 'okundu'} olarak işaretlendi.`, unread ? 'bi-envelope' : 'bi-envelope-open');
        }

        function bulkDelete() { deleteMessages([...inboxState.checked]); }

        /* Gelen Kutusu'nda klavye ile satır seçimi (j / k, ↑ / ↓, Enter ile aç) */
        function moveCursor(dir) {
          const list = getFiltered();
          if (!list.length) return;
          let i = list.findIndex(m => m.id === inboxState.selectedId);
          i = i < 0 ? 0 : Math.min(list.length - 1, Math.max(0, i + dir));
          inboxState.selectedId = list[i].id;
          inboxState.page = Math.floor(i / inboxState.perPage) + 1;
          renderList();
          const row = $(`.msg-item[data-id="${list[i].id}"]`);
          if (row) { row.focus({ preventScroll: true }); row.scrollIntoView({ block: 'nearest' }); }
        }

        /* ======================================================================
           5a. MESAJ DETAY VIEW  (ileride Views/Inbox/Detail.cshtml → /Inbox/Detail/{id})
           ====================================================================== */
        function navIds() {
          const ids = (inboxState.navList || getFiltered().map(m => m.id)).filter(id => messages.some(m => m.id === id));
          return ids.length ? ids : messages.map(m => m.id);
        }

        function stepMessage(dir) {
          const ids = navIds(), i = ids.indexOf(inboxState.selectedId);
          if (i < 0) return;
          const next = ids[i + dir];
          if (next != null) openMessage(next, { keepNav: true });
        }

        function refreshMessagePage() {
          if (currentPage !== 'message') return;
          $('#mainContent').innerHTML = renderMessageView(inboxState.selectedId);
          initMessageView(inboxState.selectedId);
        }

        function renderMessageView(param) {
          const m = messages.find(x => x.id === +param);
          if (!m) {
            return `
              <section class="msg-page" id="msgPage">
                <div class="mp-top">
                  <button type="button" class="btn-soft mp-back" data-act="back"><i class="bi bi-arrow-left"></i><span>Gelen Kutusu</span></button>
                </div>
                <div class="mp-empty">
                  <div class="ic"><i class="bi bi-envelope-x"></i></div>
                  <h5>Mesaj bulunamadı</h5>
                  <p class="mb-0">Bu mesaj silinmiş veya taşınmış olabilir.</p>
                </div>
              </section>`;
          }

          const ids = navIds(), idx = ids.indexOf(m.id);
          const hasPrev = idx > 0, hasNext = idx > -1 && idx < ids.length - 1;
          const nextUp = (idx > -1 ? ids.slice(idx + 1, idx + 5) : []).map(id => messages.find(x => x.id === id)).filter(Boolean);
          const atts = (m.attachments || []).map(a => {
            const [ic, col] = fileIcon[a.t] || fileIcon.pdf;
            return `<div class="att"><div class="fi ${col}"><i class="bi ${ic}"></i></div><div><div class="fn">${a.n}</div><div class="fs">${a.s}</div></div><i class="bi bi-download ms-auto" style="color:var(--muted)"></i></div>`;
          }).join('');

          return `
            <section class="msg-page" id="msgPage">

              <!-- Üst çubuk: geri dön + mesaj işlemleri -->
              <div class="mp-top">
                <button type="button" class="btn-soft mp-back" data-act="back" title="Gelen Kutusu'na dön"><i class="bi bi-arrow-left"></i><span>Gelen Kutusu</span></button>
                <div class="mp-toolbar" role="toolbar" aria-label="Mesaj işlemleri">
                  <button class="tool-btn" data-act="reply" title="Yanıtla"><i class="bi bi-reply"></i></button>
                  <button class="tool-btn" data-act="forward" title="İlet"><i class="bi bi-forward"></i></button>
                  <span class="tb-divider"></span>
                  <button class="tool-btn" data-act="unread" title="Okunmadı olarak işaretle"><i class="bi bi-envelope"></i></button>
                  <button class="tool-btn" data-act="delete" title="Sil"><i class="bi bi-trash3"></i></button>
                  <button class="tool-btn hide-xs" data-act="print" title="Yazdır"><i class="bi bi-printer"></i></button>
                  <span class="tb-divider"></span>
                  <span class="mp-counter">${idx > -1 ? idx + 1 : '–'} / ${ids.length}</span>
                  <button class="tool-btn" data-act="prev" ${hasPrev ? '' : 'disabled'} title="Önceki mesaj (k)"><i class="bi bi-chevron-left"></i></button>
                  <button class="tool-btn" data-act="next" ${hasNext ? '' : 'disabled'} title="Sonraki mesaj (j)"><i class="bi bi-chevron-right"></i></button>
                </div>
              </div>

              <div class="mp-grid">
                <!-- Mesaj içeriği -->
                <article class="mp-card">
                  <div class="pv-subject-row">
                    <h1 class="pv-subject">${escapeHtml(m.subject)}</h1>
                    <button class="star-btn ${m.starred ? 'on' : ''}" data-act="star" title="Yıldızla"><i class="bi ${m.starred ? 'bi-star-fill' : 'bi-star'}"></i></button>
                  </div>
                  <div class="mb-3 d-flex gap-2 flex-wrap">
                    <span class="tag ${labelClass[m.label] || 'tag-sistem'}"><i class="bi bi-tag"></i> ${m.label}</span>
                    <span class="tag" style="background:var(--bg);color:var(--muted)"><i class="bi bi-inbox"></i> Gelen Kutusu</span>
                  </div>

                  <div class="pv-sender">
                    <span class="avatar lg ${m.color}">${initials(m.name)}</span>
                    <div class="who">
                      <div class="nm">${escapeHtml(m.name)} <span class="em">&lt;${m.email}&gt;</span></div>
                      <div class="to"><b>Kime:</b> ${escapeHtml(ME.name)} &lt;${ME.email}&gt;</div>
                      ${m.cc ? `<div class="to"><b>Bilgi:</b> ${m.cc}</div>` : ''}
                    </div>
                    <div class="dt"><b>${m.date.split(',')[0]}</b>${m.date.split(',')[1] || ''}</div>
                  </div>

                  <div class="pv-body">${m.body}</div>

                  ${atts ? `<div class="attachments"><h6><i class="bi bi-paperclip"></i> ${m.attachments.length} ek dosya</h6><div class="att-grid">${atts}</div></div>` : ''}

                  <div class="pv-actions">
                    <button class="btn-soft primary" data-act="reply"><i class="bi bi-reply-fill"></i> Yanıtla</button>
                    <button class="btn-soft" data-act="forward"><i class="bi bi-forward-fill"></i> İlet</button>
                    <button class="btn-soft" data-act="star"><i class="bi ${m.starred ? 'bi-star-fill' : 'bi-star'}" style="${m.starred ? 'color:#F2B84B' : ''}"></i> ${m.starred ? 'Yıldızı Kaldır' : 'Yıldızla'}</button>
                    <button class="btn-soft danger" data-act="delete"><i class="bi bi-trash3"></i> Sil</button>
                  </div>

                  <form class="quick-reply" id="quickReply">
                    ${userAvatar('sm')}
                    <input type="text" placeholder="${escapeHtml(m.name.split(' ')[0])} kişisine hızlı yanıt yazın…" aria-label="Hızlı yanıt">
                    <button type="submit" title="Gönder"><i class="bi bi-send-fill"></i></button>
                  </form>
                </article>

                <!-- Yan bilgi -->
                <aside class="mp-side">
                  <div class="mp-side-card">
                    <h6>Gönderen</h6>
                    <div class="mp-contact">
                      <span class="avatar lg ${m.color}">${initials(m.name)}</span>
                      <div style="min-width:0">
                        <div class="nm">${escapeHtml(m.name)}</div>
                        <div class="em">${m.email}</div>
                      </div>
                    </div>
                    <div class="mp-contact-actions">
                      <button type="button" class="btn-soft" data-act="compose-to"><i class="bi bi-send"></i> Mesaj Gönder</button>
                      <button type="button" class="btn-soft" data-act="copy-email"><i class="bi bi-copy"></i> Kopyala</button>
                    </div>
                    <ul class="mp-facts">
                      <li><span class="k"><i class="bi bi-tag"></i> Etiket</span><span class="v">${m.label}</span></li>
                      <li><span class="k"><i class="bi bi-paperclip"></i> Ekler</span><span class="v">${m.attachments && m.attachments.length ? m.attachments.length + ' dosya' : 'Yok'}</span></li>
                      <li><span class="k"><i class="bi bi-star"></i> Durum</span><span class="v">${m.starred ? 'Yıldızlı' : 'Normal'}</span></li>
                      <li><span class="k"><i class="bi bi-clock"></i> Alındı</span><span class="v">${m.date}</span></li>
                    </ul>
                  </div>

                  ${nextUp.length ? `
                  <div class="mp-side-card">
                    <h6>Sıradaki Mesajlar <span class="mp-counter" style="display:inline;padding:0">${ids.length - idx - 1} mesaj</span></h6>
                    <div class="mp-next">
                      ${nextUp.map(n => `
                        <button type="button" class="${n.unread ? 'unread' : ''}" data-open-msg="${n.id}">
                          <span class="avatar sm ${n.color}">${initials(n.name)}</span>
                          <span class="bd">
                            <span class="nm">${escapeHtml(n.name)}${n.unread ? '<span class="unread-dot"></span>' : ''}</span>
                            <span class="sj d-block">${escapeHtml(n.subject)}</span>
                          </span>
                          <span class="tm">${n.time}</span>
                        </button>`).join('')}
                    </div>
                  </div>` : ''}
                </aside>
              </div>
            </section>`;
        }

        function initMessageView(param) {
          const id = +param, m = messages.find(x => x.id === id);
          const root = $('#msgPage');

          $$('[data-act]', root).forEach(b => b.addEventListener('click', () => {
            const act = b.dataset.act;
            if (act === 'back') { renderPage('inbox'); return; }
            if (!m) return;
            if (act === 'star') toggleStar(m.id, null);
            if (act === 'delete') { renderPage('inbox'); deleteMessages([m.id]); }
            if (act === 'unread') {
              m.unread = true;
              renderPage('inbox');
              showToast('Okunmadı olarak işaretlendi.', 'bi-envelope');
            }
            if (act === 'reply') showToast(`${m.name} kişisine yanıt hazırlanıyor…`, 'bi-reply');
            if (act === 'forward') showToast('İletme ekranı Yeni Mesaj sayfasıyla birlikte gelecek.', 'bi-forward');
            if (act === 'print') showToast('Yazdırma önizlemesi hazırlanıyor…', 'bi-printer');
            if (act === 'prev') stepMessage(-1);
            if (act === 'next') stepMessage(1);
            if (act === 'compose-to') {
              composeState.pendingTo = { email: m.email, name: m.name, color: m.color, valid: true };
              renderPage('compose');
            }
            if (act === 'copy-email') {
              const done = () => showToast(`${m.email} kopyalandı.`, 'bi-clipboard-check');
              if (navigator.clipboard) navigator.clipboard.writeText(m.email).then(done, () => showToast(`Adres: ${m.email}`, 'bi-envelope'));
              else showToast(`Adres: ${m.email}`, 'bi-envelope');
            }
          }));

          if (!m) return;
          // Doğrudan adresle (#message/3) açıldığında da okundu say
          m.unread = false;
          inboxState.selectedId = id;
          updateBadges();

          $$('[data-open-msg]', root).forEach(b => b.addEventListener('click', () => openMessage(+b.dataset.openMsg, { keepNav: true })));

          $('#quickReply').addEventListener('submit', e => {
            e.preventDefault();
            const inp = $('input', e.target);
            if (!inp.value.trim()) { inp.focus(); return; }
            inp.value = '';
            showToast(`Yanıtınız ${m.name} kişisine gönderildi.`, 'bi-send-check');
          });
        }

        /* ======================================================================
           5b. YENİ MESAJ VIEW  (ileride Views/Mail/Compose.cshtml)
           Gönderim yalnızca frontend simülasyonudur; SMTP / API çağrısı yoktur.
           ====================================================================== */
        const EMAIL_RE = /^[^\s@@<>()[\],;:"]+@@[^\s@@<>()[\],;:"]+\.[a-z]{2,}$/i;
        const DRAFT_KEY = 'mailora.composeDraft';
        const MAX_TOTAL = 25 * 1024 * 1024;           // 25 MB toplam ek sınırı
        const sentMessages = [];                        // Gönderilenler sayfası için hazır veri

        /* Otomatik tamamlama için kişi listesi (gelen mesajların göndericileri + ekstra kişiler) */
        const contacts = (() => {
          const map = new Map();
          messages.forEach(m => { if (!map.has(m.email)) map.set(m.email, { name: m.name, email: m.email, color: m.color }); });
          [
            { name: 'Ece Tunç', email: 'ece.tunc@novatek.com.tr', color: 'av-mint' },
            { name: 'Oğuz Erdem', email: 'oguz.erdem@novatek.com.tr', color: 'av-blue' },
            { name: 'Pınar Aksoy', email: 'pinar.aksoy@studiopastel.co', color: 'av-rose' },
            { name: 'Kerem Polat', email: 'kerem.polat@gmail.com', color: 'av-sun' }
          ].forEach(c => map.set(c.email, c));
          return [...map.values()];
        })();

        /* Form durumu — sayfa değişse de bellekte korunur */
        const composeState = {
          to: [], cc: [], bcc: [], showCc: false, showBcc: false,
          subject: '', body: '', files: [],
          savedAt: null, dirty: false, version: 0, restored: false, sending: false
        };
        const rfApi = {};
        let autosaveTimer = null, savedRange = null, fileSeq = 0;

        const draftStorage = {
          get()  { try { return JSON.parse(localStorage.getItem(DRAFT_KEY)); } catch (e) { return null; } },
          set(v) { try { localStorage.setItem(DRAFT_KEY, JSON.stringify(v)); return true; } catch (e) { return false; } },
          clear(){ try { localStorage.removeItem(DRAFT_KEY); } catch (e) { /* yok say */ } }
        };

        const htmlToText = html => { const d = document.createElement('div'); d.innerHTML = html || ''; return d.textContent || ''; };
        const fmtClock = iso => new Date(iso).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
        const formatSize = b => b < 1024 ? `${b} B`
          : b < 1048576 ? `${(b / 1024).toLocaleString('tr-TR', { maximumFractionDigits: 0 })} KB`
          : `${(b / 1048576).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} MB`;
        const highlight = (text, q) => {
          const i = norm(text).indexOf(q);
          if (i < 0 || !q) return escapeHtml(text);
          return escapeHtml(text.slice(0, i)) + '<mark>' + escapeHtml(text.slice(i, i + q.length)) + '</mark>' + escapeHtml(text.slice(i + q.length));
        };

        function isComposeEmpty() {
          const s = composeState;
          return !s.to.length && !s.cc.length && !s.bcc.length && !s.subject.trim() && !htmlToText(s.body).trim() && !s.files.length;
        }

        /* --- Görünüm --- */
        function recipientRow(key, label) {
          const main = key === 'to';
          return `
            <div class="cmp-row rf" data-rf="${key}" ${main ? '' : 'hidden'}>
