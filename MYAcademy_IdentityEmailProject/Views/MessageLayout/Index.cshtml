              <div class="rf-box">
                <input id="rf-${key}" class="rf-input" type="text" autocomplete="off" spellcheck="false" aria-autocomplete="list">
              </div>
              ${main
                ? `<div class="rf-toggles"><button type="button" data-show="cc" title="Bilgi alıcısı ekle">CC</button><button type="button" data-show="bcc" title="Gizli alıcı ekle">BCC</button></div>`
                : `<button type="button" class="tool-btn rf-close" data-hide="${key}" title="${label} alanını kaldır"><i class="bi bi-x-lg"></i></button>`}
              <ul class="rf-suggest" role="listbox"></ul>
              <div class="cmp-err"></div>
