                      <button type="button" class="db-send" data-compose-to="${escapeHtml(c.email)}" title="${escapeHtml(c.name)} kişisine mesaj gönder" aria-label="${escapeHtml(c.name)} kişisine mesaj gönder"><i class="bi bi-send"></i></button>
