                  ${b('italic', 'bi-type-italic', 'İtalik (Ctrl+I)')}
                  ${b('underline', 'bi-type-underline', 'Altı çizili (Ctrl+U)')}
                  ${b('strikeThrough', 'bi-type-strikethrough', 'Üstü çizili')}
                  <div class="tb-wrap">
                    <button type="button" class="tb-btn" data-pop="color" title="Metin rengi"><i class="bi bi-fonts"></i><span class="cbar" id="tbColorBar"></span></button>
