        function initDashboardView() {
          const root = $('#dashboard');

          // İstatistik kartları ve "Tümünü Gör" → Gelen Kutusu (ilgili filtreyle)
          $$('[data-stat]', root).forEach(el => el.addEventListener('click', () => {
            const key = el.dataset.stat;
            if (key === 'sent') { renderPage('sent'); return; }
            openInboxWith({ filter: key === 'unread' ? 'unread' : key === 'starred' ? 'starred' : 'all' });
          }));

          // Son gelen mesajlar → Gelen Kutusu'nda ilgili mesajı seç
          $$('[data-open]', root).forEach(el => el.addEventListener('click', () => {
            const id = +el.dataset.open, m = messages.find(x => x.id === id);
            if (!m) return;
            m.unread = false;
            openInboxWith({ filter: 'all', selectedId: id });
          }));

          // Kişiye mesaj gönder → Yeni Mesaj (alıcı otomatik eklenir)
          $$('[data-compose-to]', root).forEach(el => el.addEventListener('click', () => {
            const c = contacts.find(x => x.email === el.dataset.composeTo);
            if (!c) return;
            composeState.pendingTo = { email: c.email, name: c.name, color: c.color, valid: true };
            renderPage('compose');
          }));

          // Grafik zaman filtresi
          $$('[data-range]', root).forEach(b => b.addEventListener('click', () => {
            dashRange = +b.dataset.range;
            $$('[data-range]', root).forEach(x => { const on = x === b; x.classList.toggle('active', on); x.setAttribute('aria-selected', on); });
            updateTrafficChart();
          }));

          // Özel legend: seriyi gizle / göster
          $$('[data-ds]', root).forEach(b => b.addEventListener('click', () => {
            const ch = dashCharts.traffic;
            if (!ch) return;
            const i = +b.dataset.ds, visible = ch.isDatasetVisible(i);
            ch.setDatasetVisibility(i, !visible);
            b.classList.toggle('off', visible);
            ch.update();
          }));

          buildDashboardCharts();
        }

        function openInboxWith({ filter = 'all', selectedId = null }) {
          Object.assign(inboxState, { filter, label: null, query: '', page: 1 });
          inboxState.checked.clear();
          const g = $('#globalSearch'); if (g) g.value = '';
          if (selectedId) { openMessage(selectedId); return; }   // doğrudan Mesaj Detay sayfası
          renderPage('inbox');
        }

        /* --- Chart.js --- */
        function chartFallback(canvas) {
          if (canvas && canvas.parentElement)
            canvas.parentElement.innerHTML = '<div class="db-chart-empty"><div><i class="bi bi-graph-up"></i>Grafik kütüphanesi yüklenemedi.<br>İnternet bağlantınızı kontrol edin.</div></div>';
        }

        function destroyDashboardCharts() {
          Object.keys(dashCharts).forEach(k => { if (dashCharts[k]) { dashCharts[k].destroy(); dashCharts[k] = null; } });
        }

        const chartTooltip = {
          backgroundColor: '#2E3045', titleColor: '#fff', bodyColor: '#E4E1F5',
          padding: 12, cornerRadius: 10, boxPadding: 5, usePointStyle: true,
          titleFont: { weight: '700', size: 12.5 }, bodyFont: { size: 12.5 }
        };

        const softFill = hex => ctx => {
          const { chart } = ctx, { ctx: g, chartArea } = chart;
          if (!chartArea) return 'transparent';
          const gr = g.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
          gr.addColorStop(0, hex + '40');
          gr.addColorStop(1, hex + '00');
          return gr;
        };

        function buildDashboardCharts() {
          destroyDashboardCharts();
          const tCanvas = $('#dbTraffic'), dCanvas = $('#dbDonut');
          if (typeof Chart === 'undefined') { chartFallback(tCanvas); chartFallback(dCanvas); updateTrafficLegend(getTraffic(dashRange)); return; }

          Chart.defaults.font.family = "'Plus Jakarta Sans', system-ui, sans-serif";
          Chart.defaults.color = '#85899B';

          const t = getTraffic(dashRange);
          const line = (label, data, color) => ({
            label, data, borderColor: color, backgroundColor: softFill(color), fill: true, tension: .4, borderWidth: 2.5,
            pointRadius: dashRange === 7 ? 4 : 0, pointHoverRadius: 6,
            pointBackgroundColor: '#fff', pointBorderColor: color, pointBorderWidth: 2,
            pointHoverBackgroundColor: color, pointHoverBorderColor: '#fff'
          });
          dashCharts.traffic = new Chart(tCanvas, {
            type: 'line',
            data: { labels: t.labels, datasets: [line('Gelen Mesajlar', t.inc, '#8B7FD6'), line('Gönderilen Mesajlar', t.sent, '#6FA8E8')] },
            options: {
              responsive: true, maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: {
                legend: { display: false },
                tooltip: { ...chartTooltip, callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y}` } }
              },
              scales: {
                x: { grid: { display: false }, border: { display: false }, ticks: { color: '#A6A9B8', maxRotation: 0, autoSkip: true, maxTicksLimit: 8, font: { size: 11.5 } } },
                y: { beginAtZero: true, grid: { color: '#F1F0F8' }, border: { display: false }, ticks: { color: '#A6A9B8', padding: 10, maxTicksLimit: 5, precision: 0, font: { size: 11.5 } } }
              }
            }
          });
          updateTrafficLegend(t);

          const dist = getDistribution(), total = dist.reduce((a, d) => a + d.value, 0);
          dashCharts.donut = new Chart(dCanvas, {
            type: 'doughnut',
            data: { labels: dist.map(d => d.label), datasets: [{ data: dist.map(d => d.value), backgroundColor: dist.map(d => d.color), borderWidth: 0, borderRadius: 6, spacing: 3, hoverOffset: 6 }] },
            options: {
              responsive: true, maintainAspectRatio: false, cutout: '74%',
              plugins: {
                legend: { display: false },
                tooltip: { ...chartTooltip, callbacks: { label: c => ` ${c.label}: ${c.parsed} (%${Math.round(c.parsed / Math.max(total, 1) * 100)})` } }
              }
            }
          });
        }

        function updateTrafficLegend(t) {
          const a = $('#dbLegInc'), b = $('#dbLegSent');
          if (a) a.textContent = t.totalInc.toLocaleString('tr-TR');
          if (b) b.textContent = t.totalSent.toLocaleString('tr-TR');
        }

        function updateTrafficChart() {
          const t = getTraffic(dashRange), ch = dashCharts.traffic;
          updateTrafficLegend(t);
          if (!ch) return;
          ch.data.labels = t.labels;
          ch.data.datasets[0].data = t.inc;
          ch.data.datasets[1].data = t.sent;
          ch.data.datasets.forEach(ds => { ds.pointRadius = dashRange === 7 ? 4 : 0; });
          ch.update();
        }

        /* ======================================================================
           6. LAYOUT OLAYLARI (Sidebar / Navbar) — bir kez bağlanır
           ====================================================================== */
        function openSidebar()  { document.body.classList.add('sidebar-open'); }
        function closeSidebar() { document.body.classList.remove('sidebar-open'); }

        document.addEventListener('click', e => {
          const link = e.target.closest('[data-page]');
          if (link) {
            e.preventDefault();
            const dd = link.closest('.dropdown-menu');
            if (dd) bootstrap.Dropdown.getInstance(dd.previousElementSibling)?.hide();
            renderPage(link.dataset.page);
          }
          const lbl = e.target.closest('[data-label]');
          if (lbl) {
            inboxState.label = lbl.dataset.label;
            inboxState.page = 1;
            if (currentPage === 'inbox') { renderChips(); renderList(); closeSidebar(); }
            else renderPage('inbox');
          }
        });

        // Masaüstünde menüyü daraltır / genişletir, tablet & mobilde açılır menü olarak açar
        function setSidebarCollapsed(on, persist = true) {
          document.body.classList.toggle('sidebar-collapsed', on);
          const t = $('#sidebarToggle');
          t.title = on ? 'Menüyü genişlet' : 'Menüyü daralt';
          t.setAttribute('aria-expanded', String(!on));
          if (persist) writeJSON(SIDEBAR_KEY, on);
        }
        $('#sidebarToggle').addEventListener('click', () => {
          if (window.innerWidth >= 992) setSidebarCollapsed(!document.body.classList.contains('sidebar-collapsed'));
          else openSidebar();
        });
        $('#sidebarBackdrop').addEventListener('click', closeSidebar);

        const globalSearch = $('#globalSearch');
        globalSearch.addEventListener('input', e => {
          if (currentPage !== 'inbox') {
            inboxState.query = e.target.value; inboxState.page = 1;
            renderPage('inbox');
            globalSearch.focus();
          } else {
            setQuery(e.target.value, 'global');
          }
        });

        document.addEventListener('keydown', e => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); globalSearch.focus(); }
          if (e.key === 'Escape') closeSidebar();
          if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('input, textarea, select, [contenteditable="true"]')) return;
          if (currentPage === 'inbox') {
            if (e.key === 'j' || e.key === 'ArrowDown') { e.preventDefault(); moveCursor(1); }
            if (e.key === 'k' || e.key === 'ArrowUp')   { e.preventDefault(); moveCursor(-1); }
          } else if (currentPage === 'message') {
            if (e.key === 'j') stepMessage(1);
            if (e.key === 'k') stepMessage(-1);
            if (e.key === 'Escape' || e.key === 'u') renderPage('inbox');
          }
        });

        window.addEventListener('popstate', routeFromHash);
        window.addEventListener('resize', () => { if (window.innerWidth >= 992) closeSidebar(); });

        /* ======================================================================
           7. BAŞLANGIÇ
           ====================================================================== */
        document.body.classList.add('preload');
        setSidebarCollapsed(readJSON(SIDEBAR_KEY) === true, false);
        applyProfileToLayout();
        updateBadges();
        routeFromHash();
        requestAnimationFrame(() => requestAnimationFrame(() => document.body.classList.remove('preload')));
    </script>
</body>
</html>


